            "archive-response-headers",
            "landing-page",
            "landing-response-headers",
            "copyright-page",
            "copyright-response-headers"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^sources/nero/2026-08/[A-Za-z0-9._-]+$"
        },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https://www\\.jobsandskills\\.gov\\.au/" },
        "media_type": { "enum": ["application/zip", "text/html", "text/plain"] },
        "byte_length": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "archiveMember": {
