{
  "name": "mind-flow",
  "private": true,
  "scripts": {
    "test": "npm run test:contracts && npm run test:evidence && npm run test:options && npm run test:forecasts && npm run test:dashboard && npm run test:rehearsal && npm run test:communications",
    "test:contracts": "node --test contracts/tests/*.test.mjs",
    "test:evidence": "node --test evidence/claims/tests/*.test.mjs evidence/assumptions/tests/*.test.mjs",
    "test:options": "node --test options/tests/*.test.mjs",
    "test:forecasts": "node --test forecasts/tests/*.test.mjs",
    "test:dashboard": "node --test dashboard/tests/*.test.mjs",
    "test:rehearsal": "node --test pilots/australia/rehearsal/tests/*.test.mjs",
    "test:communications": "node --test communications/tests/*.test.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
