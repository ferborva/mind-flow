{
  "name": "mind-flow",
  "private": true,
  "scripts": {
    "test": "npm run test:contracts && npm run test:agency-map && npm run test:executable-if && npm run test:integration && npm run test:evolution && npm run test:evidence && npm run test:signals && npm run test:paths && npm run test:options && npm run test:preparation && npm run test:forecasts && npm run test:dashboard && npm run test:pilot && npm run test:rehearsal && npm run test:communications && npm run test:experience",
    "test:contracts": "node --test contracts/tests/*.test.mjs",
    "test:agency-map": "node --test contracts/agency-map/tests/*.test.mjs",
    "test:executable-if": "node --test contracts/executable-if/tests/*.test.mjs",
    "test:integration": "node --test integration/transition-bundle/tests/*.test.mjs",
    "test:integration:migration": "node --test integration/transition-bundle/tests/pending/*.acceptance.mjs",
    "test:evolution": "node --test contracts/evolution/tests/*.test.mjs",
    "test:evidence": "node --test evidence/claims/tests/*.test.mjs evidence/assumptions/tests/*.test.mjs",
    "test:signals": "node --test signals/tests/*.test.mjs",
    "test:paths": "node --test paths/tests/*.test.mjs",
    "test:options": "node --test options/tests/*.test.mjs",
    "test:preparation": "node --test preparation/tests/*.test.mjs",
    "test:forecasts": "node --test forecasts/tests/*.test.mjs",
    "test:dashboard": "node --test dashboard/tests/*.test.mjs",
    "test:pilot": "node --test pilots/australia/tests/*.test.mjs",
    "test:rehearsal": "node --test pilots/australia/rehearsal/tests/*.test.mjs",
    "test:communications": "node --test communications/tests/*.test.mjs",
    "test:experience": "node --test experiments/observatory-comparison/tests/*.test.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
