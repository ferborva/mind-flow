{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mind-flow.org/contracts/evolution/executable-if-overlay/2-0-0",
  "title": "Executable IF evolution assessment overlay",
  "description": "A content-addressed assessment and governance overlay over one exact executable IF kernel. Definition history remains owned by the kernel. Validity does not establish empirical truth, authority or permission.",
  "type": "object",
  "required": [
    "schema_version",
    "ledger_id",
    "classification",
    "generated_at",
    "source_kernel_ref",
    "source_history_ref",
    "condition_projections",
    "governance_events",
    "current_state",
    "publication_anchor",
    "public_projection",
    "manifest_hash",
    "contract_boundary"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "ledger_id": { "$ref": "#/$defs/id" },
    "classification": { "const": "research-draft" },
    "generated_at": { "$ref": "#/$defs/instant" },
    "source_kernel_ref": { "$ref": "#/$defs/sourceKernelRef" },
    "source_history_ref": { "$ref": "#/$defs/sourceHistoryRef" },
    "condition_projections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/conditionProjection" }
    },
    "governance_events": {
      "type": "array",
      "maxItems": 0,
      "description": "Round 4 deliberately opens no assessment transition. A later minor version will specify the independent governance-event chain."
    },
    "current_state": { "$ref": "#/$defs/currentState" },
    "publication_anchor": { "$ref": "#/$defs/publicationAnchor" },
    "public_projection": { "$ref": "#/$defs/publicProjection" },
    "manifest_hash": { "$ref": "#/$defs/hash" },
    "contract_boundary": { "$ref": "#/$defs/contractBoundary" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "semver": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "stringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "evaluatorRef": {
      "type": "object",
      "required": ["id", "version", "digest", "implementation_digest", "conformance_vectors_digest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "digest": { "$ref": "#/$defs/hash" },
        "implementation_digest": { "$ref": "#/$defs/hash" },
        "conformance_vectors_digest": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "sourceKernelRef": {
      "type": "object",
      "required": ["artifact_path", "artifact_sha256", "kernel_id", "manifest_hash", "evaluator_ref"],
      "properties": {
        "artifact_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*\\.json$"
        },
        "artifact_sha256": { "$ref": "#/$defs/hash" },
        "kernel_id": { "$ref": "#/$defs/id" },
        "manifest_hash": { "$ref": "#/$defs/hash" },
        "evaluator_ref": { "$ref": "#/$defs/evaluatorRef" }
      },
      "additionalProperties": false
    },
    "conditionDefinitionRef": {
      "type": "object",
      "required": ["condition_id", "definition_version", "definition_hash"],
      "properties": {
        "condition_id": { "$ref": "#/$defs/id" },
        "definition_version": { "$ref": "#/$defs/semver" },
        "definition_hash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "sourceEventRef": {
      "type": "object",
      "required": ["sequence", "event_id", "operation", "event_hash"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "event_id": { "$ref": "#/$defs/id" },
        "operation": { "enum": ["added", "narrowed", "definition-revised", "split", "merge"] },
        "event_hash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "sourceHistoryRef": {
      "type": "object",
      "required": [
        "history_status",
        "event_count",
        "tip_sequence",
        "tip_event_id",
        "tip_event_hash",
        "operations",
        "event_refs",
        "active_condition_definition_refs",
        "evidence_event_count",
        "evidence_tip_event_id",
        "evidence_tip_event_hash",
        "evidence_state_hash"
      ],
      "properties": {
        "history_status": { "const": "complete-and-locally-validated" },
        "event_count": { "type": "integer", "minimum": 1 },
        "tip_sequence": { "type": "integer", "minimum": 1 },
        "tip_event_id": { "$ref": "#/$defs/id" },
        "tip_event_hash": { "$ref": "#/$defs/hash" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["added", "narrowed", "definition-revised", "split", "merge"] }
        },
        "event_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceEventRef" }
        },
        "active_condition_definition_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/conditionDefinitionRef" }
        },
        "evidence_event_count": { "type": "integer", "minimum": 1 },
        "evidence_tip_event_id": { "$ref": "#/$defs/id" },
        "evidence_tip_event_hash": { "$ref": "#/$defs/hash" },
        "evidence_state_hash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "claimPeriod": {
      "type": "object",
      "required": ["starts_at", "ends_at"],
      "properties": {
        "starts_at": { "$ref": "#/$defs/instant" },
        "ends_at": { "$ref": "#/$defs/instant" }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["who", "verb", "object", "standard", "polarity", "period"],
      "properties": {
        "who": { "$ref": "#/$defs/nonEmpty" },
        "verb": { "$ref": "#/$defs/nonEmpty" },
        "object": { "$ref": "#/$defs/nonEmpty" },
        "standard": { "$ref": "#/$defs/nonEmpty" },
        "polarity": { "enum": ["affirmative", "negative"] },
        "period": { "$ref": "#/$defs/claimPeriod" }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["jurisdictions", "geographies", "cohorts", "services"],
      "properties": {
        "jurisdictions": { "$ref": "#/$defs/stringSet" },
        "geographies": { "$ref": "#/$defs/stringSet" },
        "cohorts": { "$ref": "#/$defs/stringSet" },
        "services": { "$ref": "#/$defs/stringSet" }
      },
      "additionalProperties": false
    },
    "evidenceStateRef": {
      "type": "object",
      "required": ["event_count", "tip_event_id", "tip_event_hash", "state_hash"],
      "properties": {
        "event_count": { "type": "integer", "minimum": 1 },
        "tip_event_id": { "$ref": "#/$defs/id" },
        "tip_event_hash": { "$ref": "#/$defs/hash" },
        "state_hash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "conditionProjection": {
      "type": "object",
      "required": [
        "condition_definition_ref",
        "source_state_version",
        "source_lifecycle",
        "source_event_ref",
        "proposition",
        "claim",
        "scope",
        "evidence_state_ref",
        "assessment_status",
        "assessment",
        "unresolved_challenge_ids"
      ],
      "properties": {
        "condition_definition_ref": { "$ref": "#/$defs/conditionDefinitionRef" },
        "source_state_version": { "type": "integer", "minimum": 1 },
        "source_lifecycle": { "const": "active" },
        "source_event_ref": { "$ref": "#/$defs/sourceEventRef" },
        "proposition": { "$ref": "#/$defs/nonEmpty" },
        "claim": { "$ref": "#/$defs/claim" },
        "scope": { "$ref": "#/$defs/scope" },
        "evidence_state_ref": { "$ref": "#/$defs/evidenceStateRef" },
        "assessment_status": { "const": "open" },
        "assessment": { "type": "null" },
        "unresolved_challenge_ids": { "type": "array", "maxItems": 0 }
      },
      "additionalProperties": false
    },
    "currentState": {
      "type": "object",
      "required": ["as_of_sequence", "as_of_event_id", "as_of_event_hash", "evidence_state_hash", "conditions"],
      "properties": {
        "as_of_sequence": { "type": "integer", "minimum": 1 },
        "as_of_event_id": { "$ref": "#/$defs/id" },
        "as_of_event_hash": { "$ref": "#/$defs/hash" },
        "evidence_state_hash": { "$ref": "#/$defs/hash" },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/conditionProjection" }
        }
      },
      "additionalProperties": false
    },
    "publicationAnchor": {
      "type": "object",
      "required": ["verification_status", "checkpoint_uri", "source_event_count", "tip_event_id", "tip_event_hash"],
      "properties": {
        "verification_status": { "const": "not-verified-by-external-checkpoint" },
        "checkpoint_uri": { "type": "string", "format": "uri", "pattern": "^https://" },
        "source_event_count": { "type": "integer", "minimum": 1 },
        "tip_event_id": { "$ref": "#/$defs/id" },
        "tip_event_hash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "publicProjection": {
      "type": "object",
      "required": ["history", "active_conditions", "boundaries"],
      "properties": {
        "history": {
          "type": "object",
          "required": ["status", "change_count", "operations", "notice"],
          "properties": {
            "status": { "const": "complete-source-bound" },
            "change_count": { "type": "integer", "minimum": 1 },
            "operations": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["added", "narrowed", "definition-revised", "split", "merge"] }
            },
            "notice": { "$ref": "#/$defs/nonEmpty" }
          },
          "additionalProperties": false
        },
        "active_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["condition_definition_ref", "proposition", "claim", "scope", "assessment_status"],
            "properties": {
              "condition_definition_ref": { "$ref": "#/$defs/conditionDefinitionRef" },
              "proposition": { "$ref": "#/$defs/nonEmpty" },
              "claim": { "$ref": "#/$defs/claim" },
              "scope": { "$ref": "#/$defs/scope" },
              "assessment_status": { "const": "open" }
            },
            "additionalProperties": false
          }
        },
        "boundaries": {
          "type": "object",
          "required": ["mechanical_rule_state_is_empirical_truth", "authority_granted", "action_authorised"],
          "properties": {
            "mechanical_rule_state_is_empirical_truth": { "const": false },
            "authority_granted": { "const": false },
            "action_authorised": { "const": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "contractBoundary": {
      "type": "object",
      "required": ["definition_history_owner", "history_validity_effect", "condition_truth_effect", "authority_effect", "action_authorisation_effect"],
      "properties": {
        "definition_history_owner": { "const": "source-executable-if-kernel" },
        "history_validity_effect": { "const": "source-binding-and-integrity-only" },
        "condition_truth_effect": { "const": "none" },
        "authority_effect": { "const": "none" },
        "action_authorisation_effect": { "const": "none" }
      },
      "additionalProperties": false
    }
  }
}
