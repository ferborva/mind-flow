{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mind-flow.org/contracts/evaluator-registry/1-0-0",
  "title": "Condition evaluator registry",
  "description": "Repository-local evaluator identity and content-digest pins. Registration conveys no policy or action authority.",
  "type": "object",
  "required": ["schema_version", "authority_effect", "evaluators"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "authority_effect": { "const": "none" },
    "evaluators": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evaluator" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evaluator": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
        "digest_kind": { "enum": ["source-sha256", "executable-manifest-sha256"] },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  }
}
