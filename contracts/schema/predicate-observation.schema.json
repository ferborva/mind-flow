{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mind-flow.org/contracts/predicate-observation/1-0-0",
  "title": "Seldon Observatory predicate observation",
  "description": "An append-only, reasoned assessment of one predicate against one immutable condition definition.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "condition_definition",
    "predicate_ref",
    "state",
    "reason",
    "period",
    "recorded_at",
    "coverage",
    "uncertainty",
    "evidence",
    "provenance"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.0\\.[0-9]+$" },
    "id": { "$ref": "#/$defs/id" },
    "condition_definition": { "$ref": "#/$defs/definitionReference" },
    "predicate_ref": { "$ref": "#/$defs/id" },
    "state": { "$ref": "#/$defs/predicateTruthState" },
    "reason": { "$ref": "#/$defs/nonEmptyString" },
    "period": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "recorded_at": { "type": "string", "format": "date-time" },
    "state_probability": { "type": "number", "minimum": 0, "maximum": 1 },
    "stale_since": { "type": "string", "format": "date-time" },
    "coverage": {
      "type": "object",
      "required": ["expected", "observed", "unit", "explanation"],
      "properties": {
        "expected": { "type": "integer", "minimum": 0 },
        "observed": { "type": "integer", "minimum": 0 },
        "unit": { "$ref": "#/$defs/nonEmptyString" },
        "explanation": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "uncertainty": { "$ref": "#/$defs/uncertainty" },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "state": { "enum": ["true", "false"] } },
        "required": ["state"]
      },
      "then": {
        "properties": { "evidence": { "type": "array", "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": { "state": { "const": "conflicted" } },
        "required": ["state"]
      },
      "then": {
        "properties": { "evidence": { "type": "array", "minItems": 2 } }
      }
    },
    {
      "if": {
        "properties": { "state": { "const": "stale" } },
        "required": ["state"]
      },
      "then": {
        "required": ["stale_since"],
        "properties": {
          "stale_since": { "type": "string", "format": "date-time" },
          "evidence": { "type": "array", "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "predicateTruthState": {
      "description": "Truth state of the scoped predicate. This is not a binding, lifecycle or measurement state.",
      "enum": ["true", "false", "unknown", "stale", "conflicted"]
    },
    "definitionReference": {
      "type": "object",
      "required": ["id", "version", "checksum"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
        "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "uncertainty": {
      "type": "object",
      "required": ["status", "rationale"],
      "properties": {
        "status": { "enum": ["quantified", "not-quantified", "not-applicable"] },
        "rationale": { "$ref": "#/$defs/nonEmptyString" },
        "method": { "$ref": "#/$defs/nonEmptyString" },
        "lower": { "type": "number" },
        "upper": { "type": "number" },
        "confidence": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "quantified" } },
            "required": ["status"]
          },
          "then": {
            "required": ["method", "lower", "upper", "confidence"],
            "properties": {
              "method": { "$ref": "#/$defs/nonEmptyString" },
              "lower": { "type": "number" },
              "upper": { "type": "number" },
              "confidence": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": ["source_id", "url", "retrieved_at", "vintage", "checksum", "quality", "licence"],
      "properties": {
        "source_id": { "$ref": "#/$defs/id" },
        "url": { "type": "string", "format": "uri" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "vintage": { "$ref": "#/$defs/nonEmptyString" },
        "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "quality": { "enum": ["exploratory", "provisional", "validated"] },
        "licence": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["producer", "method_version", "software_checksum"],
      "properties": {
        "producer": {
          "type": "object",
          "required": ["organisation", "role"],
          "properties": {
            "organisation": { "$ref": "#/$defs/nonEmptyString" },
            "role": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        "method_version": { "$ref": "#/$defs/nonEmptyString" },
        "software_checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  }
}
