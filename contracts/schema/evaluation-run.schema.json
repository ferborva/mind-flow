{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mind-flow.org/contracts/evaluation-run/1-0-0",
  "title": "Seldon Observatory evaluation run",
  "description": "An append-only record of predicate inputs and deterministic outputs for all condition gates.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "run_status",
    "condition_definition",
    "evaluated_at",
    "predicate_results",
    "gate_results",
    "action_resolution",
    "provenance"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.0\\.[0-9]+$" },
    "id": { "$ref": "#/$defs/id" },
    "run_status": { "const": "completed" },
    "condition_definition": { "$ref": "#/$defs/definitionReference" },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "predicate_results": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/predicateResult" }
    },
    "gate_results": {
      "type": "object",
      "required": ["watch", "act", "pause", "reverse", "recover", "graduate"],
      "properties": {
        "watch": { "$ref": "#/$defs/gateResult" },
        "act": { "$ref": "#/$defs/gateResult" },
        "pause": { "$ref": "#/$defs/gateResult" },
        "reverse": { "$ref": "#/$defs/gateResult" },
        "recover": { "$ref": "#/$defs/gateResult" },
        "graduate": { "$ref": "#/$defs/gateResult" }
      },
      "additionalProperties": false
    },
    "action_resolution": { "$ref": "#/$defs/actionResolution" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "predicateTruthState": {
      "description": "Truth state of one evidence-resolved predicate. This is not a binding, lifecycle or measurement state.",
      "enum": ["true", "false", "unknown", "stale", "conflicted"]
    },
    "gateTruthState": {
      "description": "Truth state produced by combining predicate-truth inputs for one gate.",
      "enum": ["true", "false", "unknown", "stale", "conflicted"]
    },
    "gate": { "enum": ["watch", "act", "pause", "reverse", "recover", "graduate"] },
    "definitionReference": {
      "type": "object",
      "required": ["id", "version", "checksum"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
        "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "predicateResult": {
      "type": "object",
      "required": ["observation_id", "state", "reason"],
      "properties": {
        "observation_id": { "$ref": "#/$defs/id" },
        "state": { "$ref": "#/$defs/predicateTruthState" },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "traceEntry": {
      "type": "object",
      "required": ["predicate_ref", "state", "path"],
      "properties": {
        "predicate_ref": { "$ref": "#/$defs/id" },
        "state": { "$ref": "#/$defs/predicateTruthState" },
        "path": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "gateResult": {
      "type": "object",
      "required": [
        "state",
        "trace",
        "decisive_predicates",
        "uncertain_predicates",
        "skipped_predicates",
        "errors"
      ],
      "properties": {
        "state": { "$ref": "#/$defs/gateTruthState" },
        "trace": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/traceEntry" }
        },
        "decisive_predicates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "uncertain_predicates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "skipped_predicates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "errors": { "type": "array", "maxItems": 0 }
      },
      "additionalProperties": false
    },
    "actionResolution": {
      "type": "object",
      "description": "Deterministic activation result derived from gate-truth states. Reverse and pause are hard safeguards.",
      "required": [
        "input_state_axis",
        "decision",
        "activation_allowed",
        "eligible_gates",
        "blocking_gates",
        "unresolved_hard_safeguards"
      ],
      "properties": {
        "input_state_axis": { "const": "gate_truth" },
        "decision": { "enum": ["no_action", "act", "pause", "reverse"] },
        "activation_allowed": { "type": "boolean" },
        "eligible_gates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/gate" }
        },
        "blocking_gates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/gate" }
        },
        "unresolved_hard_safeguards": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["pause", "reverse"] }
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["producer", "engine", "engine_version", "engine_checksum"],
      "properties": {
        "producer": {
          "type": "object",
          "required": ["organisation", "role"],
          "properties": {
            "organisation": { "$ref": "#/$defs/nonEmptyString" },
            "role": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        "engine": { "$ref": "#/$defs/nonEmptyString" },
        "engine_version": { "$ref": "#/$defs/nonEmptyString" },
        "engine_checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  }
}
