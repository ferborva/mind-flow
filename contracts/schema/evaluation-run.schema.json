{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mind-flow.org/contracts/evaluation-run/3-0-0",
  "title": "Seldon Observatory evaluation run",
  "description": "A pure, append-only record of predicate inputs and deterministic condition outputs. It contains no action lifecycle state, transition proposal or owner event.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "run_status",
    "condition_definition",
    "evaluated_at",
    "predicate_results",
    "gate_results",
    "condition_resolution",
    "provenance"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^3\\.0\\.[0-9]+$" },
    "id": { "$ref": "#/$defs/id" },
    "run_status": { "const": "completed" },
    "condition_definition": { "$ref": "#/$defs/definitionReference" },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "predicate_results": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/predicateResult" }
    },
    "gate_results": {
      "type": "object",
      "required": ["watch", "prepare", "act", "pause", "reverse", "recover", "graduate"],
      "properties": {
        "watch": { "$ref": "#/$defs/gateResult" },
        "prepare": { "$ref": "#/$defs/gateResult" },
        "act": { "$ref": "#/$defs/gateResult" },
        "pause": { "$ref": "#/$defs/gateResult" },
        "reverse": { "$ref": "#/$defs/gateResult" },
        "recover": { "$ref": "#/$defs/gateResult" },
        "graduate": { "$ref": "#/$defs/gateResult" }
      },
      "additionalProperties": false
    },
    "condition_resolution": {
      "allOf": [{ "$ref": "#/$defs/conditionResolution" }],
      "description": "Orthogonal, non-authorising condition outputs and safety precedence."
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "predicateTruthState": {
      "description": "Truth state of one evidence-resolved predicate. This is not a binding, lifecycle or measurement state.",
      "enum": ["true", "false", "unknown", "stale", "conflicted"]
    },
    "gateTruthState": {
      "description": "Truth state produced by combining predicate-truth inputs for one gate.",
      "enum": ["true", "false", "unknown", "stale", "conflicted"]
    },
    "gate": { "enum": ["watch", "prepare", "act", "pause", "reverse", "recover", "graduate"] },
    "definitionReference": {
      "type": "object",
      "required": ["id", "version", "checksum"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
        "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "predicateResult": {
      "type": "object",
      "required": ["observation_id", "state", "reason"],
      "properties": {
        "observation_id": { "$ref": "#/$defs/id" },
        "state": { "$ref": "#/$defs/predicateTruthState" },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "traceEntry": {
      "type": "object",
      "required": ["predicate_ref", "state", "path"],
      "properties": {
        "predicate_ref": { "$ref": "#/$defs/id" },
        "state": { "$ref": "#/$defs/predicateTruthState" },
        "path": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "gateResult": {
      "type": "object",
      "required": [
        "state",
        "trace",
        "decisive_predicates",
        "uncertain_predicates",
        "skipped_predicates",
        "errors"
      ],
      "properties": {
        "state": { "$ref": "#/$defs/gateTruthState" },
        "trace": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/traceEntry" }
        },
        "decisive_predicates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "uncertain_predicates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "skipped_predicates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "errors": { "type": "array", "maxItems": 0 }
      },
      "additionalProperties": false
    },
    "conditionResolution": {
      "type": "object",
      "description": "Deterministic, non-authorising condition result derived from gate-truth states. It does not activate, pause, reverse, recover or graduate an action.",
      "required": [
        "input_state_axis",
        "safety_control",
        "candidate_phase",
        "concurrent_duties",
        "exit_candidate",
        "candidate_phase_eligible",
        "concurrent_duties_eligible",
        "exit_candidate_eligible",
        "true_gates",
        "blocking_gates",
        "unresolved_hard_safeguards",
        "transition_conflicts"
      ],
      "properties": {
        "input_state_axis": { "const": "gate_truth" },
        "safety_control": { "enum": ["none", "reverse", "pause", "precautionary_hold"] },
        "candidate_phase": { "enum": ["idle", "watch", "prepare", "act"] },
        "concurrent_duties": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["watch", "recover"] }
        },
        "exit_candidate": { "enum": ["none", "graduate"] },
        "candidate_phase_eligible": {
          "type": "boolean",
          "description": "The candidate phase is present, is not blocked by a safety control and has no conflict on its axis. This is not authority, approval, activation or a command."
        },
        "concurrent_duties_eligible": {
          "type": "object",
          "required": ["watch", "recover"],
          "properties": {
            "watch": { "type": "boolean" },
            "recover": { "type": "boolean" }
          },
          "additionalProperties": false,
          "description": "Per-duty condition eligibility. Recovery can remain eligible during a safety control, but conflicts with graduation."
        },
        "exit_candidate_eligible": {
          "type": "boolean",
          "description": "The graduation candidate is present and is not blocked by safety or a transition conflict. This is not authority or execution."
        },
        "true_gates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/gate" }
        },
        "blocking_gates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/gate" }
        },
        "unresolved_hard_safeguards": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["pause", "reverse"] }
        },
        "transition_conflicts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["act_and_graduate", "recover_and_graduate"] }
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["producer", "evaluator"],
      "properties": {
        "producer": {
          "type": "object",
          "required": ["organisation", "role"],
          "properties": {
            "organisation": { "$ref": "#/$defs/nonEmptyString" },
            "role": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        "evaluator": {
          "type": "object",
          "required": ["id", "version", "digest"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
            "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
