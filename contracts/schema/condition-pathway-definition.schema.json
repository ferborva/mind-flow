{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mind-flow.org/contracts/condition-pathway-definition/1-0-0",
  "title": "Condition pathway definition",
  "description": "An immutable set of positive, adverse, measurement-alternative and recovery paths bound to explicit IF gates. A possible path is not a crisis verdict, probability, forecast or command.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "definition_version",
    "created_at",
    "public_term",
    "title",
    "summary",
    "scope",
    "condition_definitions",
    "branches",
    "participation_safeguards",
    "claim_boundary",
    "governance",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "definition_version": { "$ref": "#/$defs/version" },
    "created_at": { "type": "string", "format": "date-time" },
    "public_term": { "const": "possible-path" },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "summary": { "$ref": "#/$defs/nonEmptyString" },
    "scope": { "$ref": "#/$defs/scope" },
    "condition_definitions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/conditionReference" }
    },
    "branches": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/branch" }
    },
    "participation_safeguards": { "$ref": "#/$defs/participationSafeguards" },
    "claim_boundary": { "$ref": "#/$defs/claimBoundary" },
    "governance": { "$ref": "#/$defs/governance" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "gate": { "enum": ["watch", "prepare", "act", "pause", "reverse", "recover", "graduate"] },
    "gateTruthState": { "enum": ["true", "false", "unknown", "stale", "conflicted"] },
    "artifactReference": {
      "type": "object",
      "required": ["id", "version", "checksum"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "checksum": { "$ref": "#/$defs/checksum" }
      },
      "additionalProperties": false
    },
    "conditionReference": { "$ref": "#/$defs/artifactReference" },
    "scope": {
      "type": "object",
      "required": ["jurisdictions", "geographies", "cohorts", "services"],
      "properties": {
        "jurisdictions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "geographies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "cohorts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "services": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } }
      },
      "additionalProperties": false
    },
    "bindingInterpretation": {
      "type": "object",
      "required": ["class", "evidence_refs"],
      "properties": {
        "class": { "enum": ["hypothesis-only", "descriptive-association", "causal-estimate"] },
        "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/artifactReference" } }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "class": { "const": "hypothesis-only" } }, "required": ["class"] },
          "then": { "properties": { "evidence_refs": { "type": "array", "maxItems": 0 } } },
          "else": { "properties": { "evidence_refs": { "type": "array", "minItems": 1 } } }
        }
      ]
    },
    "gateTest": {
      "type": "object",
      "required": ["id", "condition_definition", "gate", "expected_states"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "condition_definition": { "$ref": "#/$defs/conditionReference" },
        "gate": { "$ref": "#/$defs/gate" },
        "expected_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/gateTruthState" }
        }
      },
      "additionalProperties": false
    },
    "forecastRelation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "forecast_ref"],
          "properties": {
            "status": { "enum": ["not-issued", "not-estimable"] },
            "forecast_ref": { "type": "null" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "forecast_ref"],
          "properties": {
            "status": { "const": "linked" },
            "forecast_ref": { "$ref": "#/$defs/artifactReference" }
          },
          "additionalProperties": false
        }
      ]
    },
    "earlyWarning": {
      "type": "object",
      "required": [
        "readiness",
        "detector_ref",
        "loss_function_ref",
        "performance_evidence_ref",
        "review_capacity_ref",
        "lead_time_evidence_ref",
        "authority_effect"
      ],
      "properties": {
        "readiness": { "enum": ["not-ready", "shadow-ready"] },
        "detector_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifactReference" }] },
        "loss_function_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifactReference" }] },
        "performance_evidence_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifactReference" }] },
        "review_capacity_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifactReference" }] },
        "lead_time_evidence_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifactReference" }] },
        "authority_effect": { "const": "none" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "readiness": { "const": "not-ready" } }, "required": ["readiness"] },
          "then": {
            "properties": {
              "detector_ref": { "type": "null" },
              "loss_function_ref": { "type": "null" },
              "performance_evidence_ref": { "type": "null" },
              "review_capacity_ref": { "type": "null" },
              "lead_time_evidence_ref": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "detector_ref": { "$ref": "#/$defs/artifactReference" },
              "loss_function_ref": { "$ref": "#/$defs/artifactReference" },
              "performance_evidence_ref": { "$ref": "#/$defs/artifactReference" },
              "review_capacity_ref": { "$ref": "#/$defs/artifactReference" },
              "lead_time_evidence_ref": { "$ref": "#/$defs/artifactReference" }
            }
          }
        }
      ]
    },
    "operationalAction": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "authority_effect", "option_refs"],
          "properties": {
            "status": { "const": "none" },
            "authority_effect": { "const": "none" },
            "option_refs": { "type": "array", "maxItems": 0 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "authority_effect", "option_refs"],
          "properties": {
            "status": { "const": "candidate-only" },
            "authority_effect": { "const": "none" },
            "option_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/artifactReference" } }
          },
          "additionalProperties": false
        }
      ]
    },
    "branch": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title",
        "public_statement",
        "binding_interpretation",
        "gate_tests",
        "next_discriminating_predicates",
        "forecast_relation",
        "early_warning",
        "operational_action"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["positive", "adverse", "measurement-alternative", "recovery"] },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "public_statement": { "$ref": "#/$defs/nonEmptyString" },
        "binding_interpretation": { "$ref": "#/$defs/bindingInterpretation" },
        "gate_tests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/gateTest" } },
        "next_discriminating_predicates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "forecast_relation": { "$ref": "#/$defs/forecastRelation" },
        "early_warning": { "$ref": "#/$defs/earlyWarning" },
        "operational_action": { "$ref": "#/$defs/operationalAction" }
      },
      "additionalProperties": false
    },
    "safeguard": {
      "type": "object",
      "required": ["status", "evidence_refs", "note"],
      "properties": {
        "status": { "enum": ["required-unverified", "externally-evidenced"] },
        "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/artifactReference" } },
        "note": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "required-unverified" } }, "required": ["status"] },
          "then": { "properties": { "evidence_refs": { "type": "array", "maxItems": 0 } } },
          "else": { "properties": { "evidence_refs": { "type": "array", "minItems": 1 } } }
        }
      ]
    },
    "participationSafeguards": {
      "type": "object",
      "required": ["affected_groups", "dissent_routes", "jurisdictional_authority", "indigenous_data_governance"],
      "properties": {
        "affected_groups": { "$ref": "#/$defs/safeguard" },
        "dissent_routes": { "$ref": "#/$defs/safeguard" },
        "jurisdictional_authority": { "$ref": "#/$defs/safeguard" },
        "indigenous_data_governance": { "$ref": "#/$defs/safeguard" }
      },
      "additionalProperties": false
    },
    "claimBoundary": {
      "type": "object",
      "required": ["probability_effect", "forecast_effect", "causal_effect", "authority_effect"],
      "properties": {
        "probability_effect": { "const": "none" },
        "forecast_effect": { "const": "reference-only" },
        "causal_effect": { "const": "none" },
        "authority_effect": { "const": "none" }
      },
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "required": ["lifecycle", "valid_from", "expires_at", "authority_effect"],
      "properties": {
        "lifecycle": { "enum": ["draft", "shadow", "retired"] },
        "valid_from": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "authority_effect": { "const": "none" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["classification", "authors", "rationale"],
      "properties": {
        "classification": { "const": "agent-proposal" },
        "authors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "rationale": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    }
  }
}
