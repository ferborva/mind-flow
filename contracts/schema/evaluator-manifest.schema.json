{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mind-flow.org/contracts/evaluator-manifest/1-0-0",
  "title": "Evaluator executable dependency manifest",
  "description": "A closed, content-addressed list of repository bytes that define one evaluator identity. It conveys no external-truth or action authority.",
  "type": "object",
  "required": ["schema_version", "id", "authority_effect", "dependencies"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "authority_effect": { "const": "none" },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "digest"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
          },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
