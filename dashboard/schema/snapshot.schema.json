{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mind-flow.local/dashboard/snapshot.schema.json",
  "title": "Seldon Observatory snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_id",
    "generated_at",
    "generator",
    "entities",
    "signals"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "snapshot_id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "generator": { "type": "string" },
    "title": { "type": "string" },
    "notes": { "type": "string" },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "name", "kind"],
        "properties": {
          "code": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "enum": ["aggregate", "country", "region"] }
        },
        "additionalProperties": false
      }
    },
    "signals": {
      "type": "array",
      "items": { "$ref": "#/$defs/signal" }
    },
    "crises": {
      "type": "array",
      "items": { "$ref": "#/$defs/crisis" }
    },
    "playbooks": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/playbook" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [{ "type": "integer" }, { "type": "number" }],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "series": {
      "type": "object",
      "required": ["entity", "points"],
      "properties": {
        "entity": { "type": "string" },
        "measure": { "type": "string" },
        "points": { "type": "array", "items": { "$ref": "#/$defs/point" } }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["name", "url", "retrieved"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "retrieved": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "signal": {
      "type": "object",
      "required": [
        "id",
        "name",
        "family",
        "status",
        "unit",
        "precision",
        "direction",
        "question",
        "why_it_matters",
        "trouble_reading",
        "source",
        "series"
      ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "family": { "type": "string" },
        "status": { "enum": ["measured", "derived", "not_measured", "unavailable"] },
        "unit": { "type": "string" },
        "precision": { "type": "integer", "minimum": 0 },
        "direction": { "enum": ["up_is_good", "down_is_good", "neutral"] },
        "question": { "type": "string" },
        "why_it_matters": { "type": "string" },
        "trouble_reading": { "type": "string" },
        "method": { "type": "string" },
        "caveats": { "type": "array", "items": { "type": "string" } },
        "source": { "$ref": "#/$defs/source" },
        "series": { "type": "array", "items": { "$ref": "#/$defs/series" } },
        "latest": {
          "type": "object",
          "required": ["entity", "year", "value"],
          "properties": {
            "entity": { "type": "string" },
            "year": { "type": "integer" },
            "value": { "type": "number" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "crisis": {
      "type": "object",
      "required": ["id", "name", "condition", "status", "leading_signals", "actions"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "condition": { "type": "string" },
        "status": { "enum": ["unscored", "watch", "activated"] },
        "why_it_matters": { "type": "string" },
        "movement": { "type": "string", "deprecated": true },
        "possible_public_responses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "communication": { "type": "string" },
        "leading_signals": { "type": "array", "items": { "type": "string" } },
        "actions": {
          "type": "object",
          "required": ["prepare", "protect", "recover"],
          "properties": {
            "prepare": { "type": "string" },
            "protect": { "type": "string" },
            "recover": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "playbook": {
      "type": "object",
      "required": ["label", "now", "warning", "crisis"],
      "properties": {
        "label": { "type": "string" },
        "principle": { "type": "string" },
        "now": { "type": "array", "items": { "type": "string" } },
        "warning": { "type": "array", "items": { "type": "string" } },
        "crisis": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
