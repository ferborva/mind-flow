{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mind-flow.local/dashboard/snapshot.schema.json",
  "title": "Abundance Transition Observatory snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_id",
    "generated_at",
    "generator",
    "reproducibility",
    "entities",
    "signals",
    "public_update",
    "if_path"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.5\\.[0-9]+$" },
    "snapshot_id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "generator": { "type": "string" },
    "title": { "type": "string" },
    "notes": { "type": "string" },
    "reproducibility": { "$ref": "#/$defs/reproducibility" },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "name", "kind"],
        "properties": {
          "code": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "enum": ["aggregate", "country", "region"] }
        },
        "additionalProperties": false
      }
    },
    "signals": {
      "type": "array",
      "items": { "$ref": "#/$defs/signal" }
    },
    "public_update": { "$ref": "#/$defs/publicUpdate" },
    "if_path": { "$ref": "#/$defs/ifPath" },
    "crises": {
      "type": "array",
      "items": { "$ref": "#/$defs/crisis" }
    },
    "playbooks": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/playbook" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nullableNonEmptyString": { "anyOf": [{ "$ref": "#/$defs/nonEmptyString" }, { "type": "null" }] },
    "ifPath": {
      "type": "object",
      "required": ["path_id", "provenance", "claim", "conditions", "decision"],
      "properties": {
        "path_id": { "$ref": "#/$defs/nonEmptyString" },
        "provenance": { "$ref": "#/$defs/proposalProvenance" },
        "claim": {
          "type": "object",
          "required": ["who", "verb", "outcome", "standard", "place", "period", "status"],
          "properties": {
            "who": { "$ref": "#/$defs/nonEmptyString" },
            "verb": { "$ref": "#/$defs/nonEmptyString" },
            "outcome": { "$ref": "#/$defs/nonEmptyString" },
            "standard": { "$ref": "#/$defs/nonEmptyString" },
            "place": { "$ref": "#/$defs/nonEmptyString" },
            "period": { "$ref": "#/$defs/nonEmptyString" },
            "status": { "enum": ["unresolved", "supported", "narrowed", "contradicted", "expired"] }
          },
          "additionalProperties": false
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "position", "question", "state", "previous_state", "evidence_grade", "summary", "because", "source_signal_ids", "strongest_challenge", "next_observation"],
            "properties": {
              "id": { "$ref": "#/$defs/nonEmptyString" },
              "label": { "$ref": "#/$defs/nonEmptyString" },
              "position": { "type": "integer", "minimum": 1 },
              "question": { "$ref": "#/$defs/nonEmptyString" },
              "state": { "$ref": "#/$defs/conditionState" },
              "previous_state": { "anyOf": [{ "$ref": "#/$defs/conditionState" }, { "type": "null" }] },
              "evidence_grade": { "$ref": "#/$defs/nonEmptyString" },
              "summary": { "$ref": "#/$defs/nonEmptyString" },
              "because": { "$ref": "#/$defs/nonEmptyString" },
              "source_signal_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
              "strongest_challenge": { "$ref": "#/$defs/nonEmptyString" },
              "next_observation": {
                "type": "object",
                "required": ["event", "on", "owner", "failure_handling"],
                "properties": {
                  "event": { "$ref": "#/$defs/nonEmptyString" },
                  "on": { "type": ["string", "null"], "format": "date" },
                  "owner": { "$ref": "#/$defs/nullableNonEmptyString" },
                  "failure_handling": { "$ref": "#/$defs/nonEmptyString" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "decision": {
          "type": "object",
          "required": ["result", "summary", "eligible_actions"],
          "properties": {
            "result": { "enum": ["no_decision", "watch", "act", "pause", "reverse", "recover", "graduate"] },
            "summary": { "$ref": "#/$defs/nonEmptyString" },
            "eligible_actions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "conditionState": { "enum": ["true", "false", "unknown", "stale", "conflicted"] },
    "proposalProvenance": {
      "type": "object",
      "required": ["status", "producer", "review_state"],
      "properties": {
        "status": { "const": "agent_proposal" },
        "producer": { "$ref": "#/$defs/nonEmptyString" },
        "review_state": { "const": "requires_fernando_review" }
      },
      "additionalProperties": false
    },
    "publicUpdate": {
      "type": "object",
      "required": [
        "update_id",
        "epistemic_class",
        "provenance",
        "scope",
        "observed",
        "affected",
        "inferred",
        "condition_change",
        "action",
        "falsifier",
        "next_check"
      ],
      "properties": {
        "update_id": { "$ref": "#/$defs/nonEmptyString" },
        "epistemic_class": { "const": "mixed" },
        "provenance": { "$ref": "#/$defs/proposalProvenance" },
        "scope": {
          "type": "object",
          "required": ["entity", "population", "place", "period"],
          "properties": {
            "entity": { "$ref": "#/$defs/nonEmptyString" },
            "population": { "$ref": "#/$defs/nonEmptyString" },
            "place": { "$ref": "#/$defs/nonEmptyString" },
            "period": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        "observed": {
          "type": "object",
          "required": ["summary", "measure", "source_signal_ids", "vintage", "uncertainty", "epistemic_class"],
          "properties": {
            "summary": { "$ref": "#/$defs/nonEmptyString" },
            "measure": { "$ref": "#/$defs/nonEmptyString" },
            "source_signal_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
            "vintage": { "type": "string", "format": "date" },
            "uncertainty": { "$ref": "#/$defs/nonEmptyString" },
            "epistemic_class": { "$ref": "#/$defs/epistemicClass" }
          },
          "additionalProperties": false
        },
        "affected": {
          "type": "object",
          "required": ["status", "summary", "excluded_or_unresolved"],
          "properties": {
            "status": { "enum": ["known", "partial", "unknown"] },
            "summary": { "$ref": "#/$defs/nonEmptyString" },
            "excluded_or_unresolved": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }
          },
          "additionalProperties": false
        },
        "inferred": {
          "type": "object",
          "required": ["summary", "inference_class", "method", "strongest_alternatives"],
          "properties": {
            "summary": { "$ref": "#/$defs/nonEmptyString" },
            "inference_class": { "enum": ["descriptive", "associational", "causal", "forecast", "scenario"] },
            "method": { "$ref": "#/$defs/nonEmptyString" },
            "strongest_alternatives": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }
          },
          "additionalProperties": false
        },
        "condition_change": {
          "type": "object",
          "required": ["changed", "summary", "condition_ids", "state", "evidence_grade"],
          "properties": {
            "changed": { "type": "boolean" },
            "summary": { "$ref": "#/$defs/nonEmptyString" },
            "condition_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
            "state": { "$ref": "#/$defs/conditionState" },
            "evidence_grade": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        "action": {
          "type": "object",
          "required": ["summary", "authorization_state", "owner", "authority", "help_route", "appeal_route"],
          "properties": {
            "summary": { "$ref": "#/$defs/nonEmptyString" },
            "authorization_state": { "enum": ["none", "proposed"] },
            "owner": { "$ref": "#/$defs/nullableNonEmptyString" },
            "authority": { "$ref": "#/$defs/nullableNonEmptyString" },
            "help_route": { "$ref": "#/$defs/nullableNonEmptyString" },
            "appeal_route": { "$ref": "#/$defs/nullableNonEmptyString" }
          },
          "additionalProperties": false
        },
        "falsifier": {
          "type": "object",
          "required": ["summary", "test", "implication"],
          "properties": {
            "summary": { "$ref": "#/$defs/nonEmptyString" },
            "test": { "$ref": "#/$defs/nonEmptyString" },
            "implication": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        "next_check": {
          "type": "object",
          "required": ["on", "owner", "event", "related_to_inference", "failure_handling"],
          "properties": {
            "on": { "type": ["string", "null"], "format": "date" },
            "owner": { "$ref": "#/$defs/nullableNonEmptyString" },
            "event": { "$ref": "#/$defs/nonEmptyString" },
            "related_to_inference": { "type": "boolean" },
            "failure_handling": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "epistemicClass": {
      "enum": ["observed", "derived", "modelled_estimate", "nowcast", "forecast"]
    },
    "epistemicRule": {
      "type": "object",
      "required": ["epistemic_class", "source_vintage", "uncertainty", "resolution_rule"],
      "properties": {
        "from_year": { "type": "integer" },
        "through_year": { "type": "integer" },
        "epistemic_class": { "$ref": "#/$defs/epistemicClass" },
        "source_vintage": { "$ref": "#/$defs/nonEmptyString" },
        "uncertainty": { "$ref": "#/$defs/nonEmptyString" },
        "resolution_rule": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "required": ["id", "version", "selected_fields", "epistemic_rules"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "selected_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "epistemic_rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/epistemicRule" }
        }
      },
      "additionalProperties": false
    },
    "rawInput": {
      "type": "object",
      "required": ["id", "sha256", "path", "byte_length", "media_type", "source_url", "retrieved_at", "response_metadata", "adapter"],
      "properties": {
        "id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "path": { "type": "string", "pattern": "^evidence/raw/[A-Za-z0-9._/-]+$" },
        "byte_length": { "type": "integer", "minimum": 0 },
        "media_type": { "$ref": "#/$defs/nonEmptyString" },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "response_metadata": {
          "type": "object",
          "required": ["http_status", "content_type", "etag", "last_modified"],
          "properties": {
            "http_status": { "type": "integer", "minimum": 100, "maximum": 599 },
            "content_type": { "$ref": "#/$defs/nullableNonEmptyString" },
            "etag": { "$ref": "#/$defs/nullableNonEmptyString" },
            "last_modified": { "$ref": "#/$defs/nullableNonEmptyString" }
          },
          "additionalProperties": false
        },
        "adapter": { "$ref": "#/$defs/adapter" }
      },
      "additionalProperties": false
    },
    "reproducibility": {
      "type": "object",
      "required": ["raw_input_status", "snapshot_rebuild_status", "raw_inputs", "residual_gap"],
      "properties": {
        "raw_input_status": { "enum": ["not_pinned", "captured_and_hash_verified"] },
        "snapshot_rebuild_status": { "const": "not_verified" },
        "raw_inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/rawInput" }
        },
        "residual_gap": { "$ref": "#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "raw_input_status": { "const": "not_pinned" } },
            "required": ["raw_input_status"]
          },
          "then": { "properties": { "raw_inputs": { "type": "array", "maxItems": 0 } } }
        },
        {
          "if": {
            "properties": { "raw_input_status": { "const": "captured_and_hash_verified" } },
            "required": ["raw_input_status"]
          },
          "then": { "properties": { "raw_inputs": { "type": "array", "minItems": 1 } } }
        }
      ],
      "additionalProperties": false
    },
    "point": {
      "type": "array",
      "prefixItems": [
        { "type": "integer" },
        { "type": "number" },
        { "$ref": "#/$defs/epistemicClass" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "series": {
      "type": "object",
      "required": ["entity", "points"],
      "properties": {
        "entity": { "type": "string" },
        "measure": { "type": "string" },
        "points": { "type": "array", "items": { "$ref": "#/$defs/point" } }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["name", "url", "retrieved"],
      "properties": {
        "name": { "type": "string" },
        "url": {
          "anyOf": [
            { "const": "" },
            { "type": "string", "format": "uri", "pattern": "^https://" }
          ]
        },
        "retrieved": { "type": "string" },
        "note": { "type": "string" },
        "adapter": { "$ref": "#/$defs/adapter" },
        "raw_input_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      },
      "additionalProperties": false
    },
    "signal": {
      "type": "object",
      "required": [
        "id",
        "name",
        "family",
        "status",
        "unit",
        "precision",
        "direction",
        "question",
        "why_it_matters",
        "trouble_reading",
        "source",
        "series"
      ],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "family": { "type": "string" },
        "status": { "enum": ["available", "not_measured", "unavailable"] },
        "unit": { "type": "string" },
        "precision": { "type": "integer", "minimum": 0 },
        "direction": { "enum": ["up_is_good", "down_is_good", "neutral"] },
        "question": { "type": "string" },
        "why_it_matters": { "type": "string" },
        "trouble_reading": { "type": "string" },
        "method": { "type": "string" },
        "caveats": { "type": "array", "items": { "type": "string" } },
        "source": { "$ref": "#/$defs/source" },
        "series": { "type": "array", "items": { "$ref": "#/$defs/series" } },
        "latest": {
          "type": "object",
          "required": ["entity", "year", "value", "epistemic_class"],
          "properties": {
            "entity": { "type": "string" },
            "year": { "type": "integer" },
            "value": { "type": "number" },
            "epistemic_class": { "$ref": "#/$defs/epistemicClass" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "crisis": {
      "type": "object",
      "required": ["id", "name", "condition", "status", "leading_signals", "actions"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "condition": { "type": "string" },
        "status": { "enum": ["unscored", "watch", "activated"] },
        "why_it_matters": { "type": "string" },
        "movement": { "type": "string", "deprecated": true },
        "possible_public_responses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "communication": { "type": "string" },
        "leading_signals": { "type": "array", "items": { "type": "string" } },
        "actions": {
          "type": "object",
          "required": ["prepare", "protect", "recover"],
          "properties": {
            "prepare": { "type": "string" },
            "protect": { "type": "string" },
            "recover": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "playbook": {
      "type": "object",
      "required": ["label", "now", "warning", "crisis"],
      "properties": {
        "label": { "type": "string" },
        "principle": { "type": "string" },
        "now": { "type": "array", "items": { "type": "string" } },
        "warning": { "type": "array", "items": { "type": "string" } },
        "crisis": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
