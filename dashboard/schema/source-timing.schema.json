{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mind-flow.local/dashboard/source-timing.schema.json",
  "title": "Observatory source timing",
  "$ref": "#/$defs/sourceTiming",
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "exactUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/checksum" }
    },
    "metadataEvidence": {
      "type": "object",
      "required": ["kind", "raw_input_id", "adapter_id", "adapter_version", "field_pointer"],
      "properties": {
        "kind": { "const": "adapter_extraction" },
        "raw_input_id": { "$ref": "#/$defs/checksum" },
        "adapter_id": { "$ref": "#/$defs/nonEmptyString" },
        "adapter_version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
        "field_pointer": { "type": "string", "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$" }
      },
      "additionalProperties": false
    },
    "publisherVintage": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "id", "evidence"],
          "properties": {
            "status": { "const": "known" },
            "id": { "$ref": "#/$defs/nonEmptyString" },
            "evidence": { "$ref": "#/$defs/metadataEvidence" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "unknown" },
            "reason": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        }
      ]
    },
    "publisherRelease": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "at", "evidence"],
          "properties": {
            "kind": { "const": "publisher_declared_instant" },
            "at": { "$ref": "#/$defs/exactUtc" },
            "evidence": { "$ref": "#/$defs/metadataEvidence" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "on", "timezone", "evidence"],
          "properties": {
            "kind": { "const": "publisher_declared_date" },
            "on": { "type": "string", "format": "date" },
            "timezone": { "const": "UTC" },
            "evidence": { "$ref": "#/$defs/metadataEvidence" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "on", "timezone", "evidence"],
          "properties": {
            "kind": { "const": "publisher_declared_local_date" },
            "on": { "type": "string", "format": "date" },
            "timezone": {
              "type": "string",
              "pattern": "^(?:unspecified|[A-Za-z_]+(?:/[A-Za-z0-9_+.-]+)+)$"
            },
            "evidence": { "$ref": "#/$defs/metadataEvidence" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "not_seen", "first_seen"],
          "properties": {
            "kind": { "const": "observed_availability" },
            "not_seen": {
              "anyOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": ["at", "absence_receipt_ids"],
                  "properties": {
                    "at": { "$ref": "#/$defs/exactUtc" },
                    "absence_receipt_ids": { "$ref": "#/$defs/evidenceIds" }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "first_seen": {
              "type": "object",
              "required": ["at", "evidence_raw_input_ids"],
              "properties": {
                "at": { "$ref": "#/$defs/exactUtc" },
                "evidence_raw_input_ids": { "$ref": "#/$defs/evidenceIds" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "unknown" },
            "reason": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        }
      ]
    },
    "retrieval": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "at", "raw_input_id"],
          "properties": {
            "kind": { "const": "exact" },
            "at": { "$ref": "#/$defs/exactUtc" },
            "raw_input_id": { "$ref": "#/$defs/checksum" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "on", "timezone", "basis"],
          "properties": {
            "kind": { "const": "calendar_date" },
            "on": { "type": "string", "format": "date" },
            "timezone": { "const": "UTC" },
            "basis": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "unknown" },
            "reason": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        }
      ]
    },
    "assessmentTime": {
      "type": "object",
      "required": ["kind", "reason"],
      "properties": {
        "kind": { "const": "unknown" },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "assessmentLineage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["signal_id", "entity", "year", "role"],
        "properties": {
          "signal_id": { "$ref": "#/$defs/nonEmptyString" },
          "entity": { "$ref": "#/$defs/nonEmptyString" },
          "measure": { "$ref": "#/$defs/nonEmptyString" },
          "year": { "type": "integer" },
          "role": { "enum": ["baseline", "comparator", "endpoint"] }
        },
        "additionalProperties": false
      }
    },
    "sourceTiming": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "publisher_vintage", "publisher_release", "retrieval"],
          "properties": {
            "kind": { "const": "external_dataset" },
            "publisher_vintage": { "$ref": "#/$defs/publisherVintage" },
            "publisher_release": { "$ref": "#/$defs/publisherRelease" },
            "retrieval": { "$ref": "#/$defs/retrieval" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "derivation_id", "computation", "inherits_from_signal_ids", "assessment_lineage"],
          "properties": {
            "kind": { "const": "derived" },
            "derivation_id": { "$ref": "#/$defs/nonEmptyString" },
            "computation": { "$ref": "#/$defs/assessmentTime" },
            "inherits_from_signal_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "assessment_lineage": { "$ref": "#/$defs/assessmentLineage" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "assessed_at"],
          "properties": {
            "kind": { "const": "instrument_gap" },
            "assessed_at": { "$ref": "#/$defs/assessmentTime" }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
