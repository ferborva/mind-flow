{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mind-flow.org/preparation/preparation-register/1-2-0",
  "title": "Executable-IF-bound preparation register",
  "description": "A source-bound, non-authorising register of plans whose eligibility is derived from exact five-state IF receipts.",
  "type": "object",
  "required": [
    "schema_version", "register_id", "as_of", "authorisation_effect",
    "evidence_truth_assessed", "condition_bindings", "evaluation_receipts",
    "evidence_bundles", "actions"
  ],
  "properties": {
    "schema_version": { "const": "1.2.0" },
    "register_id": { "$ref": "#/$defs/id" },
    "as_of": { "type": "string", "format": "date-time" },
    "authorisation_effect": { "const": "none" },
    "evidence_truth_assessed": { "const": false },
    "condition_bindings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/conditionEnvelope" } },
    "evaluation_receipts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/receiptEnvelope" } },
    "evidence_bundles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceEnvelope" } },
    "actions": { "type": "array", "minItems": 1, "items": { "$ref": "https://mind-flow.org/preparation/preparation-action/1-2-0" } }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "semver": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "pinnedRef": {
      "type": "object",
      "required": ["id", "version", "checksum"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "checksum": { "$ref": "#/$defs/checksum" }
      },
      "additionalProperties": false
    },
    "artifactRef": {
      "type": "object",
      "required": ["artifact_path", "artifact_sha256"],
      "properties": {
        "artifact_path": { "$ref": "#/$defs/nonEmpty" },
        "artifact_sha256": { "$ref": "#/$defs/checksum" }
      },
      "additionalProperties": false
    },
    "conditionDefinitionRef": {
      "type": "object",
      "required": ["condition_id", "definition_version", "definition_hash"],
      "properties": {
        "condition_id": { "$ref": "#/$defs/id" },
        "definition_version": { "$ref": "#/$defs/semver" },
        "definition_hash": { "$ref": "#/$defs/checksum" }
      },
      "additionalProperties": false
    },
    "eventRef": {
      "type": "object",
      "required": ["sequence", "event_id", "event_hash"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "event_id": { "$ref": "#/$defs/id" },
        "operation": { "$ref": "#/$defs/nonEmpty" },
        "event_hash": { "$ref": "#/$defs/checksum" }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["jurisdictions", "geographies", "cohorts", "services", "period"],
      "properties": {
        "jurisdictions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "geographies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "cohorts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "services": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "period": {
          "type": "object",
          "required": ["starts_at", "ends_at"],
          "properties": {
            "starts_at": { "type": "string", "format": "date-time" },
            "ends_at": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "conditionEnvelope": {
      "type": "object",
      "required": ["id", "version", "checksum", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "checksum": { "$ref": "#/$defs/checksum" },
        "content": {
          "type": "object",
          "required": [
            "condition_id", "public_condition", "kernel", "evolution", "condition_scope",
            "scope_relationship", "verification_state", "authority_effect", "action_authorised"
          ],
          "properties": {
            "condition_id": { "$ref": "#/$defs/id" },
            "public_condition": { "$ref": "#/$defs/nonEmpty" },
            "kernel": {
              "type": "object",
              "required": ["artifact_ref", "kernel_id", "manifest_hash", "condition_definition_ref"],
              "properties": {
                "artifact_ref": { "$ref": "#/$defs/artifactRef" },
                "kernel_id": { "$ref": "#/$defs/id" },
                "manifest_hash": { "$ref": "#/$defs/checksum" },
                "condition_definition_ref": { "$ref": "#/$defs/conditionDefinitionRef" }
              },
              "additionalProperties": false
            },
            "evolution": {
              "type": "object",
              "required": ["artifact_ref", "ledger_id", "manifest_hash", "source_state_version", "history_tip_ref", "condition_source_event_ref"],
              "properties": {
                "artifact_ref": { "$ref": "#/$defs/artifactRef" },
                "ledger_id": { "$ref": "#/$defs/id" },
                "manifest_hash": { "$ref": "#/$defs/checksum" },
                "source_state_version": { "type": "integer", "minimum": 1 },
                "history_tip_ref": { "$ref": "#/$defs/eventRef" },
                "condition_source_event_ref": { "$ref": "#/$defs/eventRef" }
              },
              "additionalProperties": false
            },
            "condition_scope": { "$ref": "#/$defs/scope" },
            "scope_relationship": { "const": "exact" },
            "verification_state": { "const": "bundle-verification-required" },
            "authority_effect": { "const": "none" },
            "action_authorised": { "const": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "receiptEnvelope": {
      "type": "object",
      "required": ["id", "version", "checksum", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "checksum": { "$ref": "#/$defs/checksum" },
        "content": {
          "type": "object",
          "required": [
            "condition_binding_ref", "evaluated_at", "clock", "evaluator_ref",
            "condition_definition_ref", "kernel_manifest_hash", "evaluation_hash",
            "evidence_state_hash", "observation_hashes", "mechanically_valid_for_evaluation",
            "computed_rule_state", "empirical_truth_established", "authority_effect",
            "action_authorised", "publication_approved"
          ],
          "properties": {
            "condition_binding_ref": { "$ref": "#/$defs/pinnedRef" },
            "evaluated_at": { "type": "string", "format": "date-time" },
            "clock": {
              "type": "object",
              "required": ["source", "trusted"],
              "properties": { "source": { "const": "caller-supplied" }, "trusted": { "const": false } },
              "additionalProperties": false
            },
            "evaluator_ref": {
              "type": "object",
              "required": ["id", "version", "digest", "schema_digest", "implementation_digest", "conformance_vectors_digest"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "version": { "$ref": "#/$defs/semver" },
                "digest": { "$ref": "#/$defs/checksum" },
                "schema_digest": { "$ref": "#/$defs/checksum" },
                "implementation_digest": { "$ref": "#/$defs/checksum" },
                "conformance_vectors_digest": { "$ref": "#/$defs/checksum" }
              },
              "additionalProperties": false
            },
            "condition_definition_ref": { "$ref": "#/$defs/conditionDefinitionRef" },
            "kernel_manifest_hash": { "$ref": "#/$defs/checksum" },
            "evaluation_hash": { "$ref": "#/$defs/checksum" },
            "evidence_state_hash": { "$ref": "#/$defs/checksum" },
            "observation_hashes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/checksum" } },
            "mechanically_valid_for_evaluation": { "type": "boolean" },
            "computed_rule_state": {
              "type": "object",
              "required": ["axis", "state"],
              "properties": {
                "axis": { "const": "computed_rule_state" },
                "state": { "enum": ["true", "false", "unknown", "stale", "conflicted"] }
              },
              "additionalProperties": false
            },
            "empirical_truth_established": { "const": false },
            "authority_effect": { "const": "none" },
            "action_authorised": { "const": false },
            "publication_approved": { "const": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "evidenceEnvelope": {
      "type": "object",
      "required": ["id", "version", "checksum", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "checksum": { "$ref": "#/$defs/checksum" },
        "content": {
          "type": "object",
          "required": ["purpose", "truth_effect", "as_of", "sources", "limitations", "external_verification"],
          "properties": {
            "purpose": { "const": "preparation-only" },
            "truth_effect": { "const": "none" },
            "as_of": { "type": "string", "format": "date-time" },
            "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
            "limitations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
            "external_verification": { "const": "not-performed" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
