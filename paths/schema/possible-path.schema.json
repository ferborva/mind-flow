{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mind-flow.example/schemas/possible-path.schema.json",
  "title": "Possible path hypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "path_id",
    "classification",
    "title",
    "hypothesis_summary",
    "epistemic_contract",
    "outcome_scope",
    "condition_anchors",
    "graph",
    "condition_evolution_policies",
    "competing_paths",
    "strongest_competing_path_id",
    "signal_portfolio",
    "population_accounting",
    "gaming_and_reflexivity",
    "intervention_state",
    "expiry",
    "abandonment",
    "governance",
    "provenance",
    "public_claim_ceiling"
  ],
  "properties": {
    "schema_version": { "enum": ["1.1", "1.2"] },
    "path_id": { "$ref": "#/$defs/id" },
    "classification": { "const": "synthetic-example-not-a-finding" },
    "title": { "$ref": "#/$defs/nonEmpty" },
    "hypothesis_summary": { "$ref": "#/$defs/nonEmpty" },
    "epistemic_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "world_model", "quantification", "selection_status", "truth_status"],
      "properties": {
        "kind": { "const": "possible-path-hypothesis" },
        "world_model": { "const": "open-world" },
        "quantification": { "const": "unscored" },
        "selection_status": { "const": "one-revisable-path-among-named-and-unnamed-possibilities" },
        "truth_status": { "const": "not-assessed" }
      }
    },
    "outcome_scope": { "$ref": "#/$defs/outcomeScope" },
    "condition_anchors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/conditionAnchor" }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_node_id", "nodes", "edges"],
      "properties": {
        "entry_node_id": { "$ref": "#/$defs/id" },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/node" }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/edge" }
        }
      }
    },
    "condition_evolution_policies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evolutionPolicy" }
    },
    "competing_paths": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/competingPath" }
    },
    "strongest_competing_path_id": { "$ref": "#/$defs/id" },
    "signal_portfolio": { "$ref": "#/$defs/signalPortfolio" },
    "population_accounting": { "$ref": "#/$defs/populationAccounting" },
    "gaming_and_reflexivity": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk_id", "mechanism", "early_observation", "response", "residual_unknown"],
        "properties": {
          "risk_id": { "$ref": "#/$defs/id" },
          "mechanism": { "$ref": "#/$defs/nonEmpty" },
          "early_observation": { "$ref": "#/$defs/nonEmpty" },
          "response": { "$ref": "#/$defs/nonEmpty" },
          "residual_unknown": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "intervention_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "exposure_status", "evidence_status", "last_checked_at"],
      "properties": {
        "state": { "enum": ["not-proposed", "proposed-not-started", "started", "paused", "ended", "unknown"] },
        "exposure_status": { "enum": ["none", "partial", "complete", "unknown"] },
        "evidence_status": { "const": "synthetic-unverified" },
        "last_checked_at": { "$ref": "#/$defs/dateTime" }
      }
    },
    "expiry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expires_at", "disposition", "reason"],
      "properties": {
        "expires_at": { "$ref": "#/$defs/dateTime" },
        "disposition": { "const": "abandon-unless-reregistered" },
        "reason": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "abandonment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "triggers", "public_notice"],
      "properties": {
        "default": { "const": "stop-and-retain-history" },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["trigger_id", "condition", "disposition", "reason"],
            "properties": {
              "trigger_id": { "$ref": "#/$defs/id" },
              "condition": { "$ref": "#/$defs/nonEmpty" },
              "disposition": { "const": "abandon-path-and-retain-record" },
              "reason": { "$ref": "#/$defs/nonEmpty" }
            }
          }
        },
        "public_notice": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auto_action",
        "authority_status",
        "action_authorised",
        "human_decision_required",
        "owner_ref",
        "authority_next_check"
      ],
      "properties": {
        "auto_action": { "const": false },
        "authority_status": { "const": "externally-unverified" },
        "action_authorised": { "const": false },
        "human_decision_required": { "const": true },
        "owner_ref": { "type": "null" },
        "authority_next_check": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author_class", "evidence_status", "created_at", "updated_at"],
      "properties": {
        "author_class": { "const": "commissioned-agent-proposal" },
        "evidence_status": { "const": "synthetic-unverified" },
        "created_at": { "$ref": "#/$defs/dateTime" },
        "updated_at": { "$ref": "#/$defs/dateTime" }
      }
    },
    "public_claim_ceiling": { "$ref": "#/$defs/nonEmpty" },
    "source_refs": { "$ref": "#/$defs/sourceRefs" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]+$" },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "dateTime": { "type": "string", "format": "date-time" },
    "conditionDefinitionRef": {
      "type": "object", "additionalProperties": false,
      "required": ["condition_id", "definition_version", "definition_hash"],
      "properties": {
        "condition_id": { "$ref": "#/$defs/id" },
        "definition_version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
        "definition_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "eventRef": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "event_id", "event_hash"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "event_id": { "$ref": "#/$defs/id" },
        "event_hash": { "$ref": "#/$defs/hash" },
        "operation": { "enum": ["added", "narrowed", "definition-revised", "split", "merge"] }
      }
    },
    "evidenceStateRef": {
      "type": "object", "additionalProperties": false,
      "required": ["kernel_id", "kernel_manifest_hash", "event_count", "tip_event_id", "tip_event_hash", "state_hash"],
      "properties": {
        "kernel_id": { "$ref": "#/$defs/id" },
        "kernel_manifest_hash": { "$ref": "#/$defs/hash" },
        "event_count": { "type": "integer", "minimum": 1 },
        "tip_event_id": { "$ref": "#/$defs/id" },
        "tip_event_hash": { "$ref": "#/$defs/hash" },
        "state_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "evaluationRef": {
      "type": "object", "additionalProperties": false,
      "required": ["evaluated_at", "evaluator_ref", "condition_definition_ref", "observation_hashes", "mechanically_valid_for_evaluation", "computed_rule_state", "empirical_truth_established", "authority_effect", "action_authorised", "kernel_manifest_hash", "evidence_state_hash", "evaluation_hash"],
      "properties": {
        "evaluated_at": { "$ref": "#/$defs/dateTime" },
        "evaluator_ref": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "version", "digest", "schema_digest", "implementation_digest", "conformance_vectors_digest"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
            "digest": { "$ref": "#/$defs/hash" },
            "schema_digest": { "$ref": "#/$defs/hash" },
            "implementation_digest": { "$ref": "#/$defs/hash" },
            "conformance_vectors_digest": { "$ref": "#/$defs/hash" }
          }
        },
        "condition_definition_ref": { "$ref": "#/$defs/conditionDefinitionRef" },
        "observation_hashes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } },
        "mechanically_valid_for_evaluation": { "type": "boolean" },
        "computed_rule_state": {
          "type": "object", "additionalProperties": false,
          "required": ["axis", "state"],
          "properties": {
            "axis": { "const": "computed_rule_state" },
            "state": { "enum": ["true", "false", "unknown", "stale", "conflicted"] }
          }
        },
        "empirical_truth_established": { "const": false },
        "authority_effect": { "const": "none" },
        "action_authorised": { "const": false },
        "kernel_manifest_hash": { "$ref": "#/$defs/hash" },
        "evidence_state_hash": { "$ref": "#/$defs/hash" },
        "evaluation_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "canonicalBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["condition_definition_ref", "evolution_manifest_hash", "history_tip_ref", "condition_source_event_ref", "evidence_state_ref", "evaluation_ref"],
      "properties": {
        "condition_definition_ref": { "$ref": "#/$defs/conditionDefinitionRef" },
        "evolution_manifest_hash": { "$ref": "#/$defs/hash" },
        "history_tip_ref": { "$ref": "#/$defs/eventRef" },
        "condition_source_event_ref": { "$ref": "#/$defs/eventRef" },
        "evidence_state_ref": { "$ref": "#/$defs/evidenceStateRef" },
        "evaluation_ref": { "$ref": "#/$defs/evaluationRef" }
      }
    },
    "sourceArtifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "artifact_path", "artifact_sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "artifact_path": { "$ref": "#/$defs/nonEmpty" },
        "artifact_sha256": { "$ref": "#/$defs/hash" },
        "manifest_hash": { "$ref": "#/$defs/hash" },
        "outcome_scope_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "sourceRefs": {
      "type": "object", "additionalProperties": false,
      "required": ["kernel", "evolution", "signal_registry", "agency_map"],
      "properties": {
        "kernel": { "$ref": "#/$defs/sourceArtifactRef" },
        "evolution": { "$ref": "#/$defs/sourceArtifactRef" },
        "signal_registry": { "$ref": "#/$defs/sourceArtifactRef" },
        "agency_map": { "$ref": "#/$defs/sourceArtifactRef" }
      }
    },
    "registeredSignalRef": {
      "type": "object", "additionalProperties": false,
      "required": ["signal_id", "metric_id", "metric_checksum", "binding_kind"],
      "properties": {
        "signal_id": { "$ref": "#/$defs/id" },
        "metric_id": { "$ref": "#/$defs/id" },
        "metric_checksum": { "$ref": "#/$defs/hash" },
        "binding_kind": { "enum": ["executable-predicate", "supplemental-observation"] }
      }
    },
    "outcomeScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["who", "verb", "object", "standard", "place", "period", "if_conditions", "scope_hash"],
      "properties": {
        "who": { "$ref": "#/$defs/nonEmpty" },
        "verb": { "$ref": "#/$defs/nonEmpty" },
        "object": { "$ref": "#/$defs/nonEmpty" },
        "standard": { "$ref": "#/$defs/nonEmpty" },
        "place": { "$ref": "#/$defs/nonEmpty" },
        "period": { "$ref": "#/$defs/nonEmpty" },
        "if_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["condition_id", "public_condition"],
            "properties": {
              "condition_id": { "$ref": "#/$defs/id" },
              "public_condition": { "$ref": "#/$defs/nonEmpty" }
            }
          }
        },
        "scope_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "conditionAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition_id",
        "ledger_ref",
        "ledger_manifest_hash",
        "condition_version",
        "as_of_sequence",
        "as_of_event_id",
        "as_of_event_hash",
        "rendered_if",
        "verification"
      ],
      "properties": {
        "condition_id": { "$ref": "#/$defs/id" },
        "ledger_ref": { "type": "string", "format": "uri" },
        "ledger_manifest_hash": { "$ref": "#/$defs/hash" },
        "condition_version": { "type": "integer", "minimum": 1 },
        "as_of_sequence": { "type": "integer", "minimum": 1 },
        "as_of_event_id": { "$ref": "#/$defs/id" },
        "as_of_event_hash": { "$ref": "#/$defs/hash" },
        "rendered_if": { "type": "string", "pattern": "^IF " },
        "verification": { "const": "external-unverified-anchor" },
        "canonical_binding": { "$ref": "#/$defs/canonicalBinding" },
        "canonical_binding_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "edgeConditionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition_id",
        "ledger_ref",
        "ledger_manifest_hash",
        "condition_version",
        "as_of_sequence",
        "as_of_event_id",
        "as_of_event_hash",
        "outcome_scope_hash"
      ],
      "properties": {
        "condition_id": { "$ref": "#/$defs/id" },
        "ledger_ref": { "type": "string", "format": "uri" },
        "ledger_manifest_hash": { "$ref": "#/$defs/hash" },
        "condition_version": { "type": "integer", "minimum": 1 },
        "as_of_sequence": { "type": "integer", "minimum": 1 },
        "as_of_event_id": { "$ref": "#/$defs/id" },
        "as_of_event_hash": { "$ref": "#/$defs/hash" },
        "outcome_scope_hash": { "$ref": "#/$defs/hash" },
        "canonical_binding_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "kind", "label", "affected_population_ids"],
      "properties": {
        "node_id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["context", "decision", "negotiation", "transition", "outcome", "abandonment"] },
        "label": { "$ref": "#/$defs/nonEmpty" },
        "affected_population_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_node_id", "action", "public_explanation"],
      "properties": {
        "target_node_id": { "$ref": "#/$defs/id" },
        "action": { "enum": ["block-edge-traversal", "human-decision-required"] },
        "public_explanation": { "$ref": "#/$defs/nonEmpty" },
        "recovery": {
          "enum": ["human-review", "repair-or-alternate", "acquire-missing-evidence", "refresh-and-re-evaluate", "adjudicate-conflict"]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "from_node_id", "to_node_id", "kind", "label", "condition_bindings", "branches"],
      "properties": {
        "edge_id": { "$ref": "#/$defs/id" },
        "from_node_id": { "$ref": "#/$defs/id" },
        "to_node_id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["consequential-decision", "negotiation", "transition"] },
        "label": { "$ref": "#/$defs/nonEmpty" },
        "condition_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/edgeConditionBinding" }
        },
        "branches": {
          "type": "object",
          "additionalProperties": false,
          "required": ["if_true", "if_false", "if_unknown"],
          "properties": {
            "if_true": { "$ref": "#/$defs/branch" },
            "if_false": { "$ref": "#/$defs/branch" },
            "if_unknown": { "$ref": "#/$defs/branch" },
            "if_stale": { "$ref": "#/$defs/branch" },
            "if_conflicted": { "$ref": "#/$defs/branch" }
          }
        }
      }
    },
    "evolutionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_id", "ledger_ref", "ledger_manifest_hash", "anchor_event_hash", "history_requirement", "on_event"],
      "properties": {
        "condition_id": { "$ref": "#/$defs/id" },
        "ledger_ref": { "type": "string", "format": "uri" },
        "ledger_manifest_hash": { "$ref": "#/$defs/hash" },
        "anchor_event_hash": { "$ref": "#/$defs/hash" },
        "history_requirement": { "const": "complete-append-only-hash-bound" },
        "on_event": {
          "type": "array",
          "minItems": 11,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation", "disposition", "reason", "next_action"],
            "properties": {
              "operation": { "enum": ["added", "narrowed", "definition-revised", "split", "merge", "merged", "challenged", "satisfied", "failed", "expired", "superseded", "disputed", "withdrawn"] },
              "disposition": { "enum": ["fail-closed", "no-effect"] },
              "reason": { "$ref": "#/$defs/nonEmpty" },
              "next_action": { "enum": ["re-register-and-review", "none-after-proof"] },
              "out_of_scope_proof": {
                "type": "object",
                "additionalProperties": false,
                "required": ["proof_type", "event_condition_id_rule", "scope_intersection_rule", "evidence_required", "reason"],
                "properties": {
                  "proof_type": { "const": "condition-id-and-scope-nonintersection" },
                  "event_condition_id_rule": { "const": "must-not-equal-bound-condition-id" },
                  "scope_intersection_rule": { "const": "must-be-empty" },
                  "evidence_required": { "const": "complete-hash-bound-event-state" },
                  "reason": { "$ref": "#/$defs/nonEmpty" }
                }
              }
            },
            "allOf": [
              {
                "if": { "properties": { "disposition": { "const": "no-effect" } } },
                "then": {
                  "required": ["out_of_scope_proof"],
                  "properties": {
                    "next_action": { "const": "none-after-proof" },
                    "out_of_scope_proof": true
                  }
                }
              },
              {
                "if": { "properties": { "disposition": { "const": "fail-closed" } } },
                "then": { "properties": { "next_action": { "const": "re-register-and-review" } } }
              }
            ]
          }
        }
      }
    },
    "competingPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_id", "label", "selection_reason", "incompatible_claim", "discriminating_observations"],
      "properties": {
        "path_id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/nonEmpty" },
        "selection_reason": { "$ref": "#/$defs/nonEmpty" },
        "incompatible_claim": { "$ref": "#/$defs/nonEmpty" },
        "discriminating_observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observation_id", "construct", "possible_path_pattern", "competing_path_pattern", "period", "source_plan", "status"],
            "properties": {
              "observation_id": { "$ref": "#/$defs/id" },
              "construct": { "$ref": "#/$defs/nonEmpty" },
              "possible_path_pattern": { "$ref": "#/$defs/nonEmpty" },
              "competing_path_pattern": { "$ref": "#/$defs/nonEmpty" },
              "period": { "$ref": "#/$defs/nonEmpty" },
              "source_plan": { "$ref": "#/$defs/nonEmpty" },
              "status": { "const": "unresolved" }
            }
          }
        }
      }
    },
    "signalPortfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_ids", "roles", "portfolio_status"],
      "properties": {
        "condition_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "portfolio_status": { "const": "research-only-unverified" },
        "roles": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "status"],
            "properties": {
              "role": { "enum": ["leading", "confirming", "counter", "outcome", "readiness", "intervention-exposure", "information-harm"] },
              "status": { "enum": ["assigned", "unresolved"] },
              "signal_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/id" }
              },
              "registered_signal_refs": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": { "$ref": "#/$defs/registeredSignalRef" }
              },
              "unresolved_reason": { "$ref": "#/$defs/nonEmpty" }
            },
            "allOf": [
              {
                "if": { "properties": { "status": { "const": "assigned" } } },
                "then": {
                  "required": ["signal_ids"],
                  "properties": { "signal_ids": true }
                }
              },
              {
                "if": { "properties": { "status": { "const": "unresolved" } } },
                "then": {
                  "required": ["unresolved_reason"],
                  "properties": { "unresolved_reason": true }
                }
              }
            ]
          }
        }
      }
    },
    "populationAccounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["affected_populations", "omissions"],
      "properties": {
        "affected_populations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["population_id", "label", "effect_channel", "voice_status"],
            "properties": {
              "population_id": { "$ref": "#/$defs/id" },
              "label": { "$ref": "#/$defs/nonEmpty" },
              "effect_channel": { "$ref": "#/$defs/nonEmpty" },
              "voice_status": { "enum": ["not-consulted", "consultation-planned", "consulted-unverified"] }
            }
          }
        },
        "omissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "entries", "search_method", "search_limitations"],
          "properties": {
            "status": { "enum": ["identified", "none-identified"] },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["population_id", "label", "omission_reason", "consequence", "remedy", "public_notice"],
                "properties": {
                  "population_id": { "$ref": "#/$defs/id" },
                  "label": { "$ref": "#/$defs/nonEmpty" },
                  "omission_reason": { "$ref": "#/$defs/nonEmpty" },
                  "consequence": { "$ref": "#/$defs/nonEmpty" },
                  "remedy": { "$ref": "#/$defs/nonEmpty" },
                  "public_notice": { "$ref": "#/$defs/nonEmpty" }
                }
              }
            },
            "search_method": { "$ref": "#/$defs/nonEmpty" },
            "search_limitations": { "$ref": "#/$defs/nonEmpty" }
          },
          "allOf": [
            {
              "if": { "properties": { "status": { "const": "identified" } } },
              "then": { "properties": { "entries": { "type": "array", "minItems": 1 } } }
            }
          ]
        }
      }
    }
  }
}
