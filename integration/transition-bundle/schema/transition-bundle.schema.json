{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mind-flow.org/integration/transition-bundle/1-0-0",
  "title": "Mind Flow transition bundle",
  "description": "A content-addressed manifest that asks whether separately validated programme artifacts describe one bounded transition. It does not establish truth, authority or permission.",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "classification",
    "as_of",
    "evaluation_clock",
    "authority_effect",
    "publication_approved",
    "action_authorised",
    "canonical",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "bundle_id": { "$ref": "#/$defs/id" },
    "classification": { "const": "research-draft" },
    "as_of": { "type": "string", "format": "date-time" },
    "evaluation_clock": {
      "type": "object",
      "required": ["evaluated_at", "source", "trusted"],
      "properties": {
        "evaluated_at": { "type": "string", "format": "date-time" },
        "source": { "enum": ["operator-supplied", "verified-time-authority"] },
        "trusted": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "authority_effect": { "const": "none" },
    "publication_approved": { "const": false },
    "action_authorised": { "const": false },
    "canonical": {
      "type": "object",
      "required": ["scope_hash", "condition_ids", "if_logic_hash", "root_role"],
      "properties": {
        "scope_hash": { "$ref": "#/$defs/sha256" },
        "condition_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "if_logic_hash": { "$ref": "#/$defs/sha256" },
        "root_role": { "const": "agency-map" }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 7,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": {
            "enum": [
              "agency-map",
              "evolution-ledger",
              "signal-registry",
              "possible-path",
              "preparation-register",
              "dashboard-snapshot",
              "forecast",
              "experiment-fact-pack"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*\\.json$"
          },
          "sha256": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
