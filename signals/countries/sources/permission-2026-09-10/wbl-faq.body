                <button type="submit" id="submitNewsletter" class="tui__solid_lightblue_btn cmp-button" onclick="validateemail(event)" data-form="world bank group newsletters::newsletter">SUBSCRIBE</button>
                </form>
                <div id="emailerrorMessageDiv"></div>
                <div class="alert nl_error successText fade" id="newsletterMsgDiv">
                    <span></span>
                    <button id="errMsgButton" aria-label="Close" class="lp lp-times"></button>
                 </div>    
				<div class="loader" id="messageLoader" style="display: none;">
					<img src="/content/dam/wbr/logo/ajax.gif" alt="loader image"/>
				</div>
            </div>
