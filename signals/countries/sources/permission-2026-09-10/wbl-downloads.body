				<li>
					<a class="tui_teaser_action_link" href="/content/dam/sites/wbl/documents/2026/WBL26-LF-Scores-Published.dta">Download Legal Frameworks Data (Stata Format)</a>
				</li>
				
				<li>
					<a class="tui_teaser_action_link" href="/content/dam/sites/wbl/documents/2026/WBL26-SF-Scores-Published.dta">Download Supportive Frameworks Data (Stata Format)</a>
				</li>
				
				<li>
					<a class="tui_teaser_action_link" href="/content/dam/sites/wbl/documents/2026/WBL26-EP-Scores-Published.dta">Download Enforcement Perceptions Data (Stata Format)</a>
