<script src="/etc.clientlibs/worldbank-bready/components/tabs/clientlibs/sites.js"></script>


</div>
<div class="text">
<div id="text-d7183c2dad" class="cmp-text">
    <h2><b>Citing WBL Data</b></h2>
<p>Learn how to cite <i>Women, Business and the Law</i> data in different contexts.</p>

</div>

    


	
    


 
</div>
<div class="teaser tui__border_lightblue_btn tui__btn">





