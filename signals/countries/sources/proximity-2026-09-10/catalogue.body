dely accepted metric for tracking access to transport in rural areas.\u003c/p\u003e\n","short_description":null,"acronym":"RAI","wb_project_reference":null,"grant_number":null,"collection_id":["WB_TRANSPORT"],"translated_title":null,"citation":"Rural Access Index, World Bank Group","collection_code":["WB_TRANSPORT"],"doi_url":null,"topics":[{"id":"deca7592-37c8-eb11-bacc-000d3a5a1c19","name":"Agriculture and Food Security"},{"id":"dfca7592-37c8-eb11-bacc-000d3a5a1c19","name":"Transport"}],"practice":null,"work_unit":null,"working_unit_vpu":null,"parent_dataset":null,"point_of_contact":[{"id":"e0ca7592-37c8-eb11-bacc-000d3a5a1c19","name":"data@worldbank.org","email":"data@worldbank.org","upi":null,"externally_visible_email":false,"role":{"code":"EXTERNAL_CONTACT","name":"External Contact"}},{"id":"e1ca7592-37c8-eb11-bacc-000d3a5a1c19","name":"Atsushi Iimi","email":"aiimi@worldbank.org","upi":"000282057","externally_visible_email":false,"role":{"code":"TEAMLEAD","name":"Team Lead"}},{"id":"e2ca7592-37c8-eb11-bacc-000d3a5a1c19","name":"Adam Stone Diehl","email":"adiehl@worldbank.org","upi":"000395967","externally_visible_email":false,"role":{"code":"COLLABORATOR","name":"Collaborator"}}],"dates":[{"id":"e3ca7592-37c8-eb11-bacc-000d3a5a1c19","date":"2010-08-30T00:00:00+00:00","type":"RELEASE_DATE"},{"id":"e4ca7592-37c8-eb11-bacc-000d3a5a1c19","date":"2023-04-23T00:00:00+00:00","type":"LAST_UPDATED_DATE"},{"id":"e5ca7592-37c8-eb11-bacc-000d3a5a1c19","date":"2017-01-31T10:58:40+00:00","type":"CREATED_DATE"}],"language_supported":[{"id":"e6ca7592-37c8-eb11-bacc-000d3a5a1c19","code":"EN","name":"English"}]},"keywords":[],"constraints":{"id":"e7ca7592-37c8-eb11-bacc-000d3a5a1c19","legal":{"access_constraints":null,"use_constraints":null,"other_constraints":null,"disclaimer":null,"copyright":null},"security":{"classification":"Public","exception":null,"user_note":null},"license":{"license_id":"Creative Commons Attribution 4.0","custom_license_information":null,"license_refere