tude":null,"east_longitude":null,"north_latitude":null,"south_latitude":null}},"lineage":{"id":"9670129d-37c8-eb11-bacc-000d3a5a1a58","harvest_system":null,"harvest_system_reference":"https://documents.worldbank.org/curated/en/861691573447265441/Paraguay-Roads-Sector-Public-Expenditure-Review"},"maintenance_information":{"id":"9770129d-37c8-eb11-bacc-000d3a5a1a58","update_frequency":null,"maintenance_note":null,"version":null,"version_date":null,"version_notes":null,"version_producer":"Gaurav Bhardwaj","version_description":null},"reference_system":{"id":"9870129d-37c8-eb11-bacc-000d3a5a1a58","reference_id":null,"version":null,"map_projection":null},"temporal_extent":{"id":"9a70129d-37c8-eb11-bacc-000d3a5a1a58","end_date":null,"start_date":null,"description":null,"duration":null,"coverage":[]},"temporal_resolution":{"periodicity":null},"spatial_resolution":{"id":"9970129d-37c8-eb11-bacc-000d3a5a1a58","granularity":null,"pixel_resolution":null},"dataset":{"id":"dcca7592-37c8-eb11-bacc-000d3a5a1c19","name":"Rural Access Index (RAI)","unique_id":"0038250"}},{"@search.score":1,"resource_id":"dbde34a0-37c8-eb11-bacc-000d3a5a1c19","name":"Rural Access Index (RAI) Supplemental Guidelines (ReCAP Publication)","resource_unique_id":"DR0046611","archive_nid":"936511","dataset_id":"dcca7592-37c8-eb11-bacc-000d3a5a1c19","download_count":null,"last_updated":"2021-02-03T00:00:00+00:00","last_updated_date":"2021-02-03T00:00:00+00:00","first_published_date":null,"identification":{"id":"ddde34a0-37c8-eb11-bacc-000d3a5a1c19","title":"Rural Access Index (RAI) Supplemental Guidelines (ReCAP Publication)","type":"Related Material","description":"This document contains supplemental guidelines to the 2016 RAI methodology (World Bank, 2016). These supplemental guidelines contain detailed, step-by-step procedures for calculation, documentation and publication of RAI (SDG 9.1.1) for a country. They follow the key tenets of the 2016 methodology, emphasizing the involvement of National Statistical Offices (NSOs) and government agencies in the process, and providing transparency and consistency in how the RAI is calculated. These guidelines also provide an alternative approach to the ‘all-season’ aspect of RAI for instances of limited data availability, by focusing on the intended purpose of the road network and the changing risks of accessibility to that network, rather than relying on physical measurements of road condition. ","status":"Active","citation":null,"sort_order":null,"work_unit":null,"keywods":[],"language_supported":[]},"constraints":{"id":"dede34a0-37c8-eb11-bacc-000d3a5a1c19","legal":{"access_constraints":null,"use_constraints":null,"other_constraints":null,"disclaimer":null,"copyright":null},"security":{"classification":"Public","exception":null,"user_note":null},"license":{"license_id":null,"custom_license_information":null,"license_reference":null,"exception":null}},"distribution":{"id":"dfde34a0-37c8-eb11-bacc-000d3a5a1c19","format":"PDF","url":null,"ext_url":null,"website_url":"https://www.research4cap.org/Library/Workmanetal-TRL-2019-RuralAccessIndexSupplementalGuidelines-ReCAP-GEN2033D-191219-compressed.pdf","distribution_description":null,"distribution_format":"PDF","distribution_size":null,"is_directory":null,"is_large_dataset":null,"file_name":null,"preview_api_url":null},"geographical_extent":{"id":"e0de34a0-37c8-eb11-bacc-000d3a5a1c19","description":null,"geo_json":null,"coverage":[],"bounding_box":{"west_longitude":null,"east_longitude":null,"north_latitude":null,"south_latitude":null}},"lineage":{"id":"e1de34a0-37c8-eb11-bacc-000d3a5a1c19","harvest_system":null,"harvest_system_reference":"https://www.research4cap.org/Library/Workmanetal-TRL-2019-RuralAccessIndexSupplementalGuidelines-ReCAP-GEN2033D-191219-compressed.pdf"},"maintenance_information":{"id":"e2de34a0-37c8-eb11-bacc-000d3a5a1c19","update_frequency":null,"maintenance_note":null,"version":null,"version_date":null,"version_notes":null,"version_producer":"Gaurav Bhardw