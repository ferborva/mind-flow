{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mind-flow.local/meta/review-freeze/1-0-0",
  "title": "Mind Flow external-review input freeze",
  "description": "A content-addressed local record of review inputs and reproduction output. Conformance does not establish approval, truth, authority, permission, publisher identity or reviewer independence.",
  "type": "object",
  "required": [
    "schema_version",
    "freeze_id",
    "status",
    "created_at",
    "generator",
    "review_target",
    "policy",
    "tracked_tree",
    "required_files",
    "build_commands",
    "runtime_inputs",
    "reproduction",
    "creator_reported_local_reproduction_passed",
    "boundaries",
    "freeze_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "freeze_id": { "$ref": "#/$defs/nonEmpty" },
    "status": { "const": "review-inputs-frozen" },
    "created_at": { "type": "string", "format": "date-time" },
    "generator": {
      "type": "object",
      "required": ["id", "version", "path", "sha256", "schema_path", "schema_sha256"],
      "properties": {
        "id": { "const": "mind-flow.review-freeze" },
        "version": { "const": "1.0.0" },
        "path": { "const": "meta/review-freeze/review-freeze.mjs" },
        "sha256": { "$ref": "#/$defs/hash" },
        "schema_path": { "const": "meta/review-freeze/review-freeze.schema.json" },
        "schema_sha256": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "review_target": {
      "type": "object",
      "required": ["ref", "commit", "tree", "commit_time", "git_object_format"],
      "properties": {
        "ref": { "$ref": "#/$defs/nonEmpty" },
        "commit": { "$ref": "#/$defs/gitObject" },
        "tree": { "$ref": "#/$defs/gitObject" },
        "commit_time": { "type": "string", "format": "date-time" },
        "git_object_format": { "enum": ["sha1", "sha256"] }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["id", "version", "checksum"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "version": { "$ref": "#/$defs/version" },
        "checksum": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "tracked_tree": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/trackedTreeEntry" }
    },
    "required_files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fileRecord" }
    },
    "build_commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/commandContract" }
    },
    "runtime_inputs": { "$ref": "#/$defs/runtimeInputs" },
    "reproduction": { "$ref": "#/$defs/reproduction" },
    "creator_reported_local_reproduction_passed": { "type": "boolean" },
    "boundaries": {
      "type": "object",
      "required": [
        "review_effect",
        "review_approval",
        "empirical_truth_established",
        "scope_mapping_truth_established",
        "legal_authority_created",
        "action_authorised",
        "publication_approved",
        "recruitment_approved",
        "operator_clock_authenticated",
        "safe_to_execute_on_host"
      ],
      "properties": {
        "review_effect": { "const": "input-integrity-only" },
        "review_approval": { "const": "not-granted" },
        "empirical_truth_established": { "const": false },
        "scope_mapping_truth_established": { "const": false },
        "legal_authority_created": { "const": false },
        "action_authorised": { "const": false },
        "publication_approved": { "const": false },
        "recruitment_approved": { "const": false },
        "operator_clock_authenticated": { "const": false },
        "safe_to_execute_on_host": { "const": false }
      },
      "additionalProperties": false
    },
    "freeze_hash": { "$ref": "#/$defs/hash" }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "gitObject": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "path": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.?(/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "fileRecord": {
      "type": "object",
      "required": ["path", "role", "git_blob_oid", "sha256", "byte_length"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "role": { "$ref": "#/$defs/nonEmpty" },
        "git_blob_oid": { "$ref": "#/$defs/gitObject" },
        "sha256": { "$ref": "#/$defs/hash" },
        "byte_length": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "trackedTreeEntry": {
      "type": "object",
      "required": ["path", "mode", "git_type", "git_oid", "sha256", "byte_length"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "mode": { "enum": ["100644", "100755", "120000"] },
        "git_type": { "const": "blob" },
        "git_oid": { "$ref": "#/$defs/gitObject" },
        "sha256": { "$ref": "#/$defs/hash" },
        "byte_length": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "commandContract": {
      "type": "object",
      "required": ["command_id", "argv", "cwd", "timeout_ms", "command_contract_sha256"],
      "properties": {
        "command_id": { "$ref": "#/$defs/nonEmpty" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "cwd": {
          "anyOf": [
            { "const": "." },
            { "$ref": "#/$defs/path" }
          ]
        },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
        "command_contract_sha256": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "executable": {
      "type": "object",
      "required": ["version", "executable_path", "executable_sha256"],
      "properties": {
        "version": { "$ref": "#/$defs/nonEmpty" },
        "executable_path": { "type": "string", "minLength": 1 },
        "executable_sha256": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "runtimeInputs": {
      "type": "object",
      "required": ["node", "npm", "git", "python3", "unzip", "sh", "operating_system", "checkout_directory_name", "command_environment", "package_lock"],
      "properties": {
        "node": { "$ref": "#/$defs/executable" },
        "npm": { "$ref": "#/$defs/executable" },
        "git": { "$ref": "#/$defs/executable" },
        "python3": { "$ref": "#/$defs/executable" },
        "unzip": { "$ref": "#/$defs/executable" },
        "sh": { "$ref": "#/$defs/executable" },
        "operating_system": {
          "type": "object",
          "required": ["platform", "release", "architecture"],
          "properties": {
            "platform": { "$ref": "#/$defs/nonEmpty" },
            "release": { "$ref": "#/$defs/nonEmpty" },
            "architecture": { "$ref": "#/$defs/nonEmpty" }
          },
          "additionalProperties": false
        },
        "checkout_directory_name": { "const": "mind-flow" },
        "command_environment": {
          "type": "object",
          "required": [
            "CI",
            "PATH",
            "LANG",
            "LC_ALL",
            "TZ",
            "npm_config_audit",
            "npm_config_fund",
            "npm_config_update_notifier",
            "npm_config_cache",
            "npm_config_userconfig",
            "npm_config_globalconfig",
            "npm_config_registry",
            "npm_config_replace_registry_host",
            "npm_config_script_shell"
          ],
          "properties": {
            "PATH": { "const": "$REVIEW_SANDBOX/.review-toolchain" },
            "CI": { "const": "1" },
            "LANG": { "const": "C" },
            "LC_ALL": { "const": "C" },
            "TZ": { "const": "UTC" },
            "npm_config_audit": { "const": "false" },
            "npm_config_fund": { "const": "false" },
            "npm_config_update_notifier": { "const": "false" },
            "npm_config_cache": { "const": "$REVIEW_SANDBOX/.npm-cache" },
            "npm_config_userconfig": { "const": "$REVIEW_SANDBOX/.npm-cache/empty-user.npmrc" },
            "npm_config_globalconfig": { "const": "$REVIEW_SANDBOX/.npm-cache/empty-global.npmrc" },
            "npm_config_registry": { "const": "https://registry.npmjs.org" },
            "npm_config_replace_registry_host": { "const": "always" },
            "npm_config_script_shell": { "const": "/bin/sh" }
          },
          "additionalProperties": false
        },
        "package_lock": {
          "type": "object",
          "required": ["path", "sha256", "byte_length"],
          "properties": {
            "path": { "const": "package-lock.json" },
            "sha256": { "$ref": "#/$defs/hash" },
            "byte_length": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "stream": {
      "type": "object",
      "required": ["sha256", "byte_length", "bytes_base64"],
      "properties": {
        "sha256": { "$ref": "#/$defs/hash" },
        "byte_length": { "type": "integer", "minimum": 0 },
        "bytes_base64": { "type": "string" }
      },
      "additionalProperties": false
    },
    "commandRun": {
      "type": "object",
      "required": ["command_id", "command_contract_sha256", "started_at", "finished_at", "exit_code", "signal", "stdout", "stderr", "spawn_error", "tracked_tree_unchanged_before", "tracked_tree_unchanged_after", "runtime_controls_unchanged"],
      "properties": {
        "command_id": { "$ref": "#/$defs/nonEmpty" },
        "command_contract_sha256": { "$ref": "#/$defs/hash" },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "exit_code": { "type": ["integer", "null"] },
        "signal": { "type": ["string", "null"] },
        "stdout": { "$ref": "#/$defs/stream" },
        "stderr": { "$ref": "#/$defs/stream" },
        "spawn_error": { "type": ["string", "null"] },
        "tracked_tree_unchanged_before": { "type": "boolean" },
        "tracked_tree_unchanged_after": { "type": "boolean" },
        "runtime_controls_unchanged": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "reproduction": {
      "type": "object",
      "required": ["status", "detached_checkout", "execution_boundary", "command_runs", "post_run_tracked_tree_unchanged", "changed_tracked_paths", "unexpected_paths"],
      "properties": {
        "status": { "enum": ["not-run", "passed", "failed"] },
        "detached_checkout": { "const": true },
        "execution_boundary": {
          "type": "object",
          "required": ["process_sandboxed", "network_isolated", "host_filesystem_isolated", "dependency_tree_content_addressed", "registry_responses_retained", "mutation_observation", "untrusted_code_containment"],
          "properties": {
            "process_sandboxed": { "const": false },
            "network_isolated": { "const": false },
            "host_filesystem_isolated": { "const": false },
            "dependency_tree_content_addressed": { "const": false },
            "registry_responses_retained": { "const": false },
            "mutation_observation": { "const": "pre-and-post-command-snapshot-only" },
            "untrusted_code_containment": { "const": "none" }
          },
          "additionalProperties": false
        },
        "command_runs": { "type": "array", "items": { "$ref": "#/$defs/commandRun" } },
        "post_run_tracked_tree_unchanged": { "type": ["boolean", "null"] },
        "changed_tracked_paths": { "type": "array", "items": { "$ref": "#/$defs/path" } },
        "unexpected_paths": { "type": "array", "items": { "$ref": "#/$defs/path" } }
      },
      "additionalProperties": false
    }
  }
}
