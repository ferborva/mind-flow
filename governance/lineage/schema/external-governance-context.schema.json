{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mind-flow.local/governance/lineage/external-governance-context.schema.json",
  "title": "Synthetic external governance context",
  "type": "object",
  "required": [
    "schema_version",
    "context_id",
    "classification",
    "captured_at",
    "source_bundle_binding",
    "participants",
    "affected_consumers",
    "representations",
    "if_binding",
    "boundaries",
    "context_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "context_id": { "$ref": "https://mind-flow.local/governance/schema/governance-record-common.schema.json#/$defs/id" },
    "classification": { "const": "synthetic-research-only" },
    "captured_at": { "$ref": "https://mind-flow.local/governance/schema/governance-record-common.schema.json#/$defs/instant" },
    "source_bundle_binding": {
      "type": "object",
      "required": [
        "bundle_id",
        "bundle_sha256",
        "bundle_as_of",
        "evaluation_hash",
        "condition_definition_ref",
        "computed_rule_state"
      ],
      "properties": {
        "bundle_id": { "$ref": "https://mind-flow.local/governance/schema/governance-record-common.schema.json#/$defs/id" },
        "bundle_sha256": { "$ref": "https://mind-flow.local/governance/schema/governance-record-common.schema.json#/$defs/hash" },
        "bundle_as_of": { "$ref": "https://mind-flow.local/governance/schema/governance-record-common.schema.json#/$defs/instant" },
        "evaluation_hash": { "$ref": "https://mind-flow.local/governance/schema/governance-record-common.schema.json#/$defs/hash" },
        "condition_definition_ref": { "$ref": "https://mind-flow.local/governance/schema/governance-record-common.schema.json#/$defs/conditionDefinitionRef" },
        "computed_rule_state": { "enum": ["true", "false", "unknown", "stale", "conflicted"] }
      },
      "additionalProperties": false
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://mind-flow.local/governance/schema/governance-record-common.schema.json#/$defs/participant" }
    },
    "affected_consumers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://mind-flow.local/governance/schema/governance-record-common.schema.json#/$defs/affectedConsumer" }
    },
    "representations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://mind-flow.local/governance/schema/governance-record-common.schema.json#/$defs/representation" }
    },
    "if_binding": { "$ref": "https://mind-flow.local/governance/schema/governance-record-common.schema.json#/$defs/ifBinding" },
    "boundaries": { "$ref": "#/$defs/closedBoundaries" },
    "context_hash": { "$ref": "https://mind-flow.local/governance/schema/governance-record-common.schema.json#/$defs/hash" }
  },
  "additionalProperties": false,
  "$defs": {
    "closedBoundaries": {
      "type": "object",
      "required": [
        "empirical_truth_established",
        "affected_party_consent_established",
        "authority_verified",
        "action_authorised",
        "publication_approved"
      ],
      "properties": {
        "empirical_truth_established": { "const": false },
        "affected_party_consent_established": { "const": false },
        "authority_verified": { "const": false },
        "action_authorised": { "const": false },
        "publication_approved": { "const": false }
      },
      "additionalProperties": false
    }
  }
}
