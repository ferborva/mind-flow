{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mind-flow.local/forecasts/binary-forecast.schema.json",
  "title": "Binary forecast record",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "epistemic_class",
    "status",
    "title",
    "question",
    "issued_at",
    "resolve_after",
    "resolve_by",
    "probability",
    "target",
    "baseline",
    "method",
    "data_vintages",
    "provenance",
    "assumptions",
    "counter_hypotheses",
    "resolution",
    "history"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^forecast\\.[a-z0-9][a-z0-9.-]+\\.v[0-9]+$" },
    "epistemic_class": { "const": "forecast" },
    "status": { "enum": ["issued", "resolved", "void"] },
    "title": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "resolve_after": { "type": "string", "format": "date-time" },
    "resolve_by": { "type": "string", "format": "date-time" },
    "probability": { "type": "number", "minimum": 0, "maximum": 1 },
    "target": { "$ref": "#/$defs/target" },
    "baseline": { "$ref": "#/$defs/baseline" },
    "method": { "$ref": "#/$defs/method" },
    "data_vintages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dataVintage" }
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "counter_hypotheses": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "resolution": { "$ref": "#/$defs/resolution" },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/historyEntry" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "issued" } } },
      "then": { "properties": { "resolution": { "$ref": "#/$defs/pendingResolution" } } }
    },
    {
      "if": { "properties": { "status": { "const": "resolved" } } },
      "then": { "properties": { "resolution": { "$ref": "#/$defs/resolvedResolution" } } }
    },
    {
      "if": { "properties": { "status": { "const": "void" } } },
      "then": { "properties": { "resolution": { "$ref": "#/$defs/voidResolution" } } }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "scope": {
      "type": "object",
      "required": ["geographies", "cohorts", "services"],
      "properties": {
        "geographies": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "cohorts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "services": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["event", "unit", "scope", "resolution_rule", "resolution_source"],
      "properties": {
        "event": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/scope" },
        "resolution_rule": { "type": "string", "minLength": 1 },
        "resolution_source": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "required": ["name", "probability", "method"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "method": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "required": ["kind", "description", "version"],
      "properties": {
        "kind": { "enum": ["human", "model", "ensemble"] },
        "description": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "dataVintage": {
      "type": "object",
      "required": ["source", "retrieved_at", "vintage", "checksum"],
      "properties": {
        "source": { "type": "string", "format": "uri" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "vintage": { "type": "string", "minLength": 1 },
        "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["author", "class", "issued_commit", "disclaimer"],
      "properties": {
        "author": { "type": "string", "minLength": 1 },
        "class": { "enum": ["agent-proposal", "human-judgement", "institutional-forecast"] },
        "issued_commit": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" },
        "disclaimer": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "pendingResolution": {
      "type": "object",
      "required": ["status"],
      "properties": { "status": { "const": "pending" } },
      "additionalProperties": false
    },
    "resolvedResolution": {
      "type": "object",
      "required": ["status", "outcome", "resolved_at", "source", "evidence_vintage"],
      "properties": {
        "status": { "const": "resolved" },
        "outcome": { "enum": [0, 1] },
        "resolved_at": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "format": "uri" },
        "evidence_vintage": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "voidResolution": {
      "type": "object",
      "required": ["status", "outcome", "voided_at", "reason"],
      "properties": {
        "status": { "const": "void" },
        "outcome": { "type": "null" },
        "voided_at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "resolution": {
      "oneOf": [
        { "$ref": "#/$defs/pendingResolution" },
        { "$ref": "#/$defs/resolvedResolution" },
        { "$ref": "#/$defs/voidResolution" }
      ]
    },
    "historyEntry": {
      "type": "object",
      "required": ["at", "event", "actor"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "event": { "enum": ["issued", "resolved", "voided"] },
        "actor": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
