            "required": false,
            "schema": {
              "type": "string",
              "default": "AFG_A"
            }
          },
          {
            "name": "format",
            "description": "<b>see also:<\/b> .csv2, .tsv, .csv.gz, .rds, .dta, .sav, .xpt, .json, .xlsx, .feather, .parquet   ",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": ".csv"
            }
          },
          {
            "name": "indicator",
            "description": "<b>see also:<\/b> <a href=\"./#get-/metadata/dic/\">/metadata/dic/?var=indicator<\/a>  ",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "description": "<b>see also:<\/b> <a href=\"./#get-/metadata/dic/\">/metadata/dic/?var=source<\/a>  ",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
