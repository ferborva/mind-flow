            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "classif2",
            "description": "<b>see also:<\/b> <a href=\"./#get-/metadata/dic/\">/metadata/dic/?var=classif2<\/a>",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "time",
            "description": "<b>4 characters for year only, ie: 2024",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "timefrom",
            "description": "<b>4 characters for stating year only, ie: 2010",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "timeto",
            "description": "<b>4 characters for ending year only, ie: 2020",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latestyear",
            "description": "<b>characters for getting latest year per ref_area, indicator, ie: TRUE",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "FALSE"
            }
          },
          {
            "name": "best_source",
            "description": "\\code{\"yes\"} (default) to get secondary source if exist \\code{\"all\"}, \\code{\"no\"} for secondary only.",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "yes"
            }
          },
          {
            "name": "type",
            "description": "code <b>see also:<\/b> label, both",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "code"
            }
          },
          {
            "name": "mode",
            "description": "currently B for best source only <b>soon also:<\/b> S for summary table and F for full records",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "channel",
            "description": "internal",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "title",
            "description": "internal",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cmd",
            "description": "deprecated",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "none"
            }
          }
        ],
        "tags": ["data"]
      }
    },
    "/metadata/toc/indicator": {
      "get": {
        "operationId": "/metadata/toc/indicator-GET",
        "summary": "get table of contents by indicator_frequency",
        "description": "<b>example:<\/b> https://rplumber.ilo.org/metadata/toc/indicator?lang=es&format=.csv",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Default response."
          }
        },
        "parameters": [
          {
            "name": "lang",
            "description": "<b>see also:<\/b> en, fr, es  ",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "en"
            }
          },
          {
            "name": "format",
            "description": "<b>see also:<\/b> .csv2, .tsv, .csv.gz, .rds, .dta, .sav, .xpt, .json, .xlsx, .feather, .parquet   ",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": ".csv"
            }
          }
        ],
        "tags": ["metadata"]
      }
    },
    "/metadata/toc/ref_area": {
      "get": {
        "operationId": "/metadata/toc/ref_area-GET",
        "summary": "get table of contents by ref_area_frequency",
        "description": "<b>example:<\/b> https://rplumber.ilo.org/metadata/toc/ref_area?lang=es&format=.csv",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Default response."
          }
        },
        "parameters": [
          {
            "name": "lang",
            "description": "<b>see also:<\/b> en, fr, es  ",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "en"
            }
          },
          {
            "name": "format",
            "description": "<b>see also:<\/b> .csv2, .tsv, .csv.gz, .rds, .dta, .sav, .xpt, .json, .xlsx, .feather, .parquet    ",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": ".csv"
            }
          }
        ],
        "tags": ["metadata"]
      }
    },
    "/metadata/validation": {
      "get": {
        "operationId": "/metadata/validation-GET",
        "description": "",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Default response.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "method",
            "description": "validation|received",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "validation"
            }
          }
        ]
      }
    },
    "/metadata/dic": {
      "get": {
        "operationId": "/metadata/dic-GET",
        "summary": "get dictionary",
        "description": "<b>example:<\/b> https://rplumber.ilo.org/metadata/dic?var=source&lang=fr&format=.csv",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Default response."
          }
        },
        "parameters": [
          {
            "name": "lang",
            "description": "<b>see also:<\/b> en, fr, es, if none the 3 languages  ",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "en"
            }
          },
          {
            "name": "var",
            "description": "<b>see also:<\/b> ref_area, indicator, sex, classif1, classif2, obs_status, note_classif, note_indicator, note_source, classif_type, database, subject  ",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "source"
            }
          },
          {
            "name": "format",
            "description": "<b>see also:<\/b> .csv2, .tsv, .csv.gz, .rds, .dta, .sav, .xpt, .json, .xlsx, .feather, .parquet   ",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": ".csv"
            }
          }
        ],
        "tags": ["metadata"]
      }
    },
    "/aggregate/data": {
      "get": {
        "operationId": "/aggregate/data-GET",
        "summary": "get aggregate data",
        "description": "<b>example:<\/b> https://rplumber.ilo.org/aggregate/data?groups=rc&indicator=UNE_2UNE_SEX_AGE_NB&type=label&format=.csv <br><b>see also web application:<\/b> https://rshiny.ilo.org/regionalaggregate/",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Default response."
          }
        },
        "parameters": [
          {
            "name": "groups",
            "description": "<b>see also:<\/b> unsd, rc, escap, unicef, childatlas and your own groups as <i>mygroup1<\/i><b>%in%<\/b>FRA+USA+DEU<b>,<\/b><i>mygroup2<\/i><b>%in%<\/b>JPN+THA   ",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "ilostat"
            }
          },
          {
            "name": "indicator",
            "description": "<b>only one indicator, see also:<\/b> available full list on <a href=\"./#get-/aggregate/indicator\">/aggregate/indicator/<\/a>  ",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "UNE_2UNE_SEX_AGE_NB"
            }
          },
          {
            "name": "type",
            "description": "<b>see also:<\/b> label, both",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "code"
            }
          },
          {
            "name": "lang",
            "description": "<b>see also:<\/b> en, fr, es  ",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "en"
            }
          },
          {
            "name": "format",
            "description": "<b>see also:<\/b> .csv2, .tsv, .csv.gz, .rds, .dta, .sav, .xpt, .json, .xlsx, .feather, .parquet   ",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": ".csv"
            }
          }
        ],
        "tags": ["aggregate"]
      }
    },
    "/aggregate/indicator": {
      "get": {
        "operationId": "/aggregate/indicator-GET",
        "summary": "get indicator available",
        "description": "<b>example:<\/b> https://rplumber.ilo.org/aggregate/indicator?format=.csv",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
