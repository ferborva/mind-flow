{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mind-flow.local/forecasts/prospective-baseline-input-manifest.schema.json",
  "title": "Prospective baseline input manifest",
  "type": "object",
  "required": [
    "artifact_type",
    "schema_version",
    "baseline_role",
    "baseline_id",
    "input_source_ids",
    "input_checksums"
  ],
  "properties": {
    "artifact_type": { "const": "prospective-baseline-input-manifest" },
    "schema_version": { "const": "1.0.0" },
    "baseline_role": { "enum": ["reference_class", "naive"] },
    "baseline_id": { "$ref": "#/$defs/id" },
    "input_source_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "input_checksums": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
